AGENT_PROJECT_CANARY_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-project-canary
AGENT_PROJECT_CANARY_CLIENT_CERT_SOURCE=./secrets/agent-runtime-project-canary/client.crt
AGENT_PROJECT_CANARY_CLIENT_KEY_SOURCE=./secrets/agent-runtime-project-canary/client.key
AGENT_PROJECT_CANARY_SERVER_CA_SOURCE=./secrets/agent-runtime-project-canary/server-ca.crt
AGENT_PROJECT_CANARY_RELEASE_MANIFEST_SOURCE=./secrets/agent-runtime-project-canary/release-manifest.json
AGENT_PROJECT_CANARY_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_PROJECT_CANARY_ACTIVATION_SOURCE=./secrets/agent-runtime-project-canary/production-activation.json
AGENT_PROJECT_CANARY_PLAN_SOURCE=./secrets/agent-runtime-project-canary/project-canary-plan.json
AGENT_PROJECT_CANARY_AUTHORITY_PRIVATE_KEY_SOURCE=./secrets/agent-runtime-project-canary/authority-private-key
AGENT_PROJECT_CANARY_AUTHORITY_PUBLIC_KEY_SOURCE=./secrets/agent-runtime-project-canary/authority-public-key
AGENT_PROJECT_CANARY_APPROVAL_DOCUMENT_SOURCE=./secrets/agent-runtime-project-canary/approval.json
AGENT_PROJECT_CANARY_APPROVAL_PUBLIC_KEY_SOURCE=./secrets/agent-runtime-project-canary/approval-public-key
AGENT_PROJECT_CANARY_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
AGENT_PROJECT_CANARY_RELAY_SUBNET=172.31.254.8/29
AGENT_PROJECT_CANARY_RELAY_IP=172.31.254.10
AGENT_PROJECT_CANARY_RELAY_LISTEN_ADDR=172.31.254.10:9445
AGENT_PROJECT_CANARY_RELAY_ENDPOINT=https://172.31.254.10:9445/internal/agent-broker/v1/relay
AGENT_PROJECT_CANARY_RELAY_TLS_CERT_SOURCE=./secrets/agent-runtime-project-canary/relay-server.crt
AGENT_PROJECT_CANARY_RELAY_TLS_KEY_SOURCE=./secrets/agent-runtime-project-canary/relay-server.key
AGENT_PROJECT_CANARY_RELAY_TLS_CLIENT_CA_SOURCE=./secrets/agent-runtime-project-canary/relay-client-ca.crt
AGENT_PROJECT_CANARY_RUNNER_RELAY_IDENTITY=spiffe://neo-chat/neo-runner-project-relay
AGENT_PROJECT_CANARY_POLL_INTERVAL=10s
AGENT_PROJECT_CANARY_RPC_TIMEOUT=10s
AGENT_PROJECT_CANARY_AUTHORITY_TTL=15s
AGENT_PROJECT_CANARY_RECONCILE_BATCH_SIZE=100

# Agent Runtime G21.4 synthetic depth-one Child canary. This tenth PostgreSQL
# principal inherits exactly agent_orchestrator_runtime, agent_runner_control
# and agent_delegation_control. The separate profile admits one fixed Parent
# and one fixed Child while Broker, MCP, Project, Provider and secret authority
# remain absent.
AGENT_CHILD_CANARY_ENABLED=false
AGENT_CHILD_CANARY_DATABASE_URL=postgres://agent_child_canary_app:change-me-agent-child-canary-postgres@postgres:5432/neo_chat?sslmode=disable
AGENT_CHILD_CANARY_RUNNER_URL=https://127.0.0.1:9443/internal/neo-runner/v1/rpc
AGENT_CHILD_CANARY_RUNNER_ID=neo-runner-primary
AGENT_CHILD_CANARY_SERVER_NAME=neo-runner.internal
AGENT_CHILD_CANARY_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-child-canary
AGENT_CHILD_CANARY_CLIENT_CERT_SOURCE=./secrets/agent-runtime-child-canary/client.crt
AGENT_CHILD_CANARY_CLIENT_KEY_SOURCE=./secrets/agent-runtime-child-canary/client.key
AGENT_CHILD_CANARY_SERVER_CA_SOURCE=./secrets/agent-runtime-child-canary/server-ca.crt
AGENT_CHILD_CANARY_RELEASE_MANIFEST_SOURCE=./secrets/agent-runtime-child-canary/release-manifest.json
AGENT_CHILD_CANARY_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_CHILD_CANARY_ACTIVATION_SOURCE=./secrets/agent-runtime-child-canary/production-activation.json
