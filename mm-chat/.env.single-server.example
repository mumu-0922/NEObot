# Copy to .env.single-server and replace every placeholder before production.
# Production preflight forbids `$` interpolation; use direct URL-safe/base64
# secret values and URL-encode database/Redis passwords inside their URLs.

# Go API
# Production requires a full registry digest. Local development may substitute
# a mutable tag for `docker compose build`, but it cannot pass preflight.
BACKEND_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat@sha256:replace-with-64-lowercase-hex
MM_CHAT_ADDR=:8080
MM_CHAT_VERSION=replace-with-release-id
# Compose file-backed secrets preserve host ownership and mode. Set these to
# the owner UID/GID of the mode-600 provider keyring (`id -u` / `id -g`).
MM_CHAT_RUNTIME_UID=replace-with-host-uid
MM_CHAT_RUNTIME_GID=replace-with-host-gid
DATABASE_URL=postgres://neo_chat_api:change-me-api-postgres@postgres:5432/neo_chat?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# PR7 compares the current v1 Top 5 with exact/CJK BM25 but never injects the
# shadow result into prompts. Keep false until the observation window begins.
MEMORY_LEXICAL_SHADOW_ENABLED=false
# PR8 runs BGE-M3 embedding jobs plus exact/BM25/vector/RRF/rerank comparison.
# It remains 0% prompt injection and controls both API and Memory Worker calls.
MEMORY_HYBRID_SHADOW_ENABLED=false
# The API-only first-round search_memory Tool remains default-off until a
# schema-v7 Development/Validation rollout is approved. It consumes the fixed
# BGE projections but must never be passed to the Memory Worker.
MEMORY_TOOL_LOOP_ENABLED=false
# Exact authenticated UUID allowlist for Memory recall. Empty is fail-closed.
MEMORY_TOOL_LOOP_CANARY_USER_IDS=
# PR11 builds same-scope derived L2 Scenes and records relevant-only shadow
# observations. The independent reader flag cannot bypass this shadow gate.
MEMORY_L2_SCENE_SHADOW_ENABLED=false
# Active Scene injection requires formal promotion or the audited migration-073
# sole-user preview; both remain jointly gated by this default-off API flag.
MEMORY_L2_SCENE_READER_ENABLED=false
# PR12 builds a compact Global-only L3 Persona and records relevant-only shadow
# observations. The independent reader flag cannot bypass this shadow gate.
MEMORY_L3_PERSONA_SHADOW_ENABLED=false
# Active Persona injection requires formal promotion or the audited migration-073
# sole-user preview; both remain jointly gated by this default-off API flag.
MEMORY_L3_PERSONA_READER_ENABLED=false

# MCP powers the user-facing Tools area. Remote MCP runs in the backend;
# approved local stdio servers run on demand in the optional mcp-runner profile.
MCP_ENABLED=false
MCP_REMOTE_ENABLED=true
MCP_STDIO_ENABLED=false
MCP_MANIFEST_FILE=/etc/mm-chat/mcp-manifest.json
MCP_RUNNER_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat-mcp-runner@sha256:replace-with-64-lowercase-hex
MCP_RUNNER_URL=http://mcp-runner:8090
MCP_RUNNER_TOKEN_SOURCE=./mcp/runner-token.disabled
# Public HTTPS in deployment, or exact loopback HTTP for local OAuth testing.
MCP_OAUTH_CALLBACK_URL=
MCP_PRIVATE_SERVER_LIMIT=20
MCP_CONVERSATION_SERVER_LIMIT=8
MCP_MAX_EXPOSED_TOOLS=32
MCP_MAX_CALLS_PER_RUN=32
MCP_MAX_ROUNDS_PER_RUN=8
MCP_MAX_CONCURRENT_PER_USER=4
MCP_MAX_PENDING_OAUTH_FLOWS=5
MCP_CALL_TIMEOUT=30s
MCP_RUN_TIMEOUT=120s
MCP_AUDIT_RETENTION=2160h
MCP_CLEANUP_INTERVAL=1h
# Optional LobeHub discovery adapter. Register the M2M client explicitly; the
# application never registers or executes Marketplace installation commands.
MCP_MARKETPLACE_ENABLED=false
MCP_MARKETPLACE_BASE_URL=https://market.lobehub.com
MCP_MARKETPLACE_CLIENT_ID=
MCP_MARKETPLACE_CLIENT_SECRET_SOURCE=./mcp/marketplace-client-secret.disabled
MCP_MARKETPLACE_TIMEOUT=8s
MCP_MARKETPLACE_CACHE_TTL=5m

# Memory v2 durable capture worker. It shares the backend image but has an
# independent login that inherits only memory_worker_runtime. Redis is an
# optional wake signal; PostgreSQL polling remains authoritative.
MEMORY_WORKER_DATABASE_URL=postgres://memory_worker:change-me-memory-worker-postgres@postgres:5432/neo_chat?sslmode=disable
MEMORY_WORKER_MAX_OPEN_CONNS=4
MEMORY_WORKER_MAX_IDLE_CONNS=2
MEMORY_WORKER_CONN_MAX_LIFETIME=30m
MEMORY_WORKER_CONCURRENCY=2
MEMORY_WORKER_LEASE_DURATION=2m
MEMORY_WORKER_POLL_INTERVAL=1s
MEMORY_WORKER_BACKOFF_BASE=5s
MEMORY_WORKER_BACKOFF_MAX=15m
MEMORY_WORKER_PROVIDER_TIMEOUT=45s

# Agent Runtime G21.0 control-plane maintenance. Every execution-stage switch
# remains false. Enabling only AGENT_RUNNER_CONTROL_ENABLED requires fresh
# exact-host activation evidence, a sixth PostgreSQL login inheriting only
# agent_runner_control, and the dedicated `agent-runtime-control` profile.
AGENT_RUNNER_CONTROL_ENABLED=false
AGENT_RUNTIME_ENABLED=false
AGENT_SCHEDULER_ENABLED=false
AGENT_SKILL_INSTALL_ENABLED=false
AGENT_LEARNING_ENABLED=false
AGENT_DELEGATION_ENABLED=false
AGENT_BROKER_READ_ONLY_ENABLED=false
AGENT_BROKER_MUTATION_ENABLED=false
AGENT_RUNNER_DATABASE_URL=postgres://agent_runner_control_app:change-me-agent-control-postgres@postgres:5432/neo_chat?sslmode=disable
AGENT_RUNNER_URL=https://127.0.0.1:9443/internal/neo-runner/v1/rpc
AGENT_RUNNER_ID=neo-runner-primary
AGENT_RUNNER_SERVER_NAME=neo-runner.internal
AGENT_RUNNER_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-control
AGENT_RUNNER_CLIENT_CERT_SOURCE=./secrets/agent-runtime-control/client.crt
AGENT_RUNNER_CLIENT_KEY_SOURCE=./secrets/agent-runtime-control/client.key
AGENT_RUNNER_SERVER_CA_SOURCE=./secrets/agent-runtime-control/server-ca.crt
AGENT_RUNNER_RELEASE_MANIFEST_SOURCE=./secrets/agent-runtime-control/release-manifest.json
AGENT_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_PRODUCTION_ACTIVATION_SOURCE=./secrets/agent-runtime-control/production-activation.json
AGENT_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
AGENT_RUNNER_POLL_INTERVAL=30s
AGENT_RUNNER_RPC_TIMEOUT=10s
AGENT_RUNNER_RECONCILE_BATCH_SIZE=100

# Agent Runtime G21.1 synthetic Root Run canary. This is a separate activation
# stage, mTLS identity and seventh PostgreSQL principal. Broad Runtime, Broker,
# Child, Cron and Learning flags remain false. The checked-in defaults do not
# start the profile or read these mounted files.
AGENT_ROOT_RUN_CANARY_ENABLED=false
AGENT_ROOT_CANARY_DATABASE_URL=postgres://agent_root_canary_app:change-me-agent-root-canary-postgres@postgres:5432/neo_chat?sslmode=disable
AGENT_ROOT_CANARY_RUNNER_URL=https://127.0.0.1:9443/internal/neo-runner/v1/rpc
AGENT_ROOT_CANARY_RUNNER_ID=neo-runner-primary
AGENT_ROOT_CANARY_SERVER_NAME=neo-runner.internal
AGENT_ROOT_CANARY_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-root-canary
AGENT_ROOT_CANARY_CLIENT_CERT_SOURCE=./secrets/agent-runtime-root-canary/client.crt
AGENT_ROOT_CANARY_CLIENT_KEY_SOURCE=./secrets/agent-runtime-root-canary/client.key
AGENT_ROOT_CANARY_SERVER_CA_SOURCE=./secrets/agent-runtime-root-canary/server-ca.crt
AGENT_ROOT_CANARY_RELEASE_MANIFEST_SOURCE=./secrets/agent-runtime-root-canary/release-manifest.json
AGENT_ROOT_CANARY_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_ROOT_CANARY_ACTIVATION_SOURCE=./secrets/agent-runtime-root-canary/production-activation.json
AGENT_ROOT_CANARY_PLAN_SOURCE=./secrets/agent-runtime-root-canary/root-canary-plan.json
AGENT_ROOT_CANARY_AUTHORITY_PRIVATE_KEY_SOURCE=./secrets/agent-runtime-root-canary/authority-private-key
AGENT_ROOT_CANARY_AUTHORITY_PUBLIC_KEY_SOURCE=./secrets/agent-runtime-root-canary/authority-public-key
AGENT_ROOT_CANARY_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
AGENT_ROOT_CANARY_POLL_INTERVAL=10s
AGENT_ROOT_CANARY_RPC_TIMEOUT=10s
AGENT_ROOT_CANARY_AUTHORITY_TTL=10s
AGENT_ROOT_CANARY_RECONCILE_BATCH_SIZE=100

# Agent Runtime G21.2 reviewed read-only Broker and Artifact canary. This
# eighth PostgreSQL principal inherits exactly agent_orchestrator_runtime,
# agent_runner_control, agent_effect_control and agent_artifact_control. The
# profile and dedicated flag stay off until short-lived exact-host evidence is
# READY. The host Runner receives only the separate relay mTLS tuple below;
# Broker database, object-store and MCP credentials remain in this process.
AGENT_BROKER_ARTIFACT_CANARY_ENABLED=false
AGENT_BROKER_CANARY_DATABASE_URL=postgres://agent_broker_canary_app:change-me-agent-broker-canary-postgres@postgres:5432/neo_chat?sslmode=disable
AGENT_BROKER_CANARY_RUNNER_URL=https://127.0.0.1:9443/internal/neo-runner/v1/rpc
AGENT_BROKER_CANARY_RUNNER_ID=neo-runner-primary
AGENT_BROKER_CANARY_RUNNER_SERVER_NAME=neo-runner.internal
AGENT_BROKER_CANARY_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-broker-canary
AGENT_BROKER_CANARY_CLIENT_CERT_SOURCE=./secrets/agent-runtime-broker-canary/client.crt
AGENT_BROKER_CANARY_CLIENT_KEY_SOURCE=./secrets/agent-runtime-broker-canary/client.key
AGENT_BROKER_CANARY_SERVER_CA_SOURCE=./secrets/agent-runtime-broker-canary/server-ca.crt
AGENT_BROKER_CANARY_RELEASE_MANIFEST_SOURCE=./secrets/agent-runtime-broker-canary/release-manifest.json
AGENT_BROKER_CANARY_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_BROKER_CANARY_ACTIVATION_SOURCE=./secrets/agent-runtime-broker-canary/production-activation.json
AGENT_BROKER_CANARY_PLAN_SOURCE=./secrets/agent-runtime-broker-canary/broker-canary-plan.json
AGENT_BROKER_CANARY_AUTHORITY_PRIVATE_KEY_SOURCE=./secrets/agent-runtime-broker-canary/authority-private-key
AGENT_BROKER_CANARY_AUTHORITY_PUBLIC_KEY_SOURCE=./secrets/agent-runtime-broker-canary/authority-public-key
AGENT_BROKER_CANARY_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
AGENT_BROKER_CANARY_RELAY_SUBNET=172.31.254.0/29
AGENT_BROKER_CANARY_RELAY_IP=172.31.254.2
AGENT_BROKER_CANARY_RELAY_LISTEN_ADDR=172.31.254.2:9444
AGENT_BROKER_CANARY_RELAY_ENDPOINT=https://172.31.254.2:9444/internal/agent-broker/v1/relay
AGENT_BROKER_CANARY_RELAY_TLS_CERT_SOURCE=./secrets/agent-runtime-broker-canary/relay-server.crt
AGENT_BROKER_CANARY_RELAY_TLS_KEY_SOURCE=./secrets/agent-runtime-broker-canary/relay-server.key
AGENT_BROKER_CANARY_RELAY_TLS_CLIENT_CA_SOURCE=./secrets/agent-runtime-broker-canary/relay-client-ca.crt
AGENT_BROKER_CANARY_RUNNER_RELAY_IDENTITY=spiffe://neo-chat/neo-runner-broker-relay
AGENT_BROKER_CANARY_QUARANTINE_SOURCE=/var/lib/neo-runner/artifacts/quarantine
AGENT_BROKER_CANARY_PROJECT_ROOT_SOURCE=./secrets/agent-runtime-broker-canary/project-read-root
AGENT_BROKER_CANARY_WORKSPACE_ROOT_SOURCE=./secrets/agent-runtime-broker-canary/workspace-read-root
AGENT_BROKER_CANARY_MCP_RUNNER_URL=http://mcp-runner:8090
AGENT_BROKER_CANARY_POLL_INTERVAL=10s
AGENT_BROKER_CANARY_RPC_TIMEOUT=10s
AGENT_BROKER_CANARY_AUTHORITY_TTL=15s
AGENT_BROKER_CANARY_RECONCILE_BATCH_SIZE=100

# Agent Runtime G21.3 synthetic Project mutation canary. This ninth PostgreSQL
# principal inherits exactly agent_orchestrator_runtime, agent_runner_control,
# agent_effect_control and agent_project_mutation_control. The dedicated
# profile remains off by default and admits one offline-approved Project CAS;
# broad Runtime/Broker mutation, MCP, S3, Provider and vault authority stay out.
AGENT_PROJECT_MUTATION_CANARY_ENABLED=false
AGENT_PROJECT_CANARY_DATABASE_URL=postgres://agent_project_canary_app:change-me-agent-project-canary-postgres@postgres:5432/neo_chat?sslmode=disable
