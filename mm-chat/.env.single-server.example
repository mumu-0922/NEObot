AGENT_CHILD_CANARY_AUTHORITY_PRIVATE_KEY_SOURCE=./secrets/agent-runtime-child-canary/authority-private-key
AGENT_CHILD_CANARY_AUTHORITY_PUBLIC_KEY_SOURCE=./secrets/agent-runtime-child-canary/authority-public-key
AGENT_CHILD_CANARY_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
AGENT_CHILD_CANARY_POLL_INTERVAL=10s
AGENT_CHILD_CANARY_RPC_TIMEOUT=10s
AGENT_CHILD_CANARY_AUTHORITY_TTL=15s
AGENT_CHILD_CANARY_RECONCILE_BATCH_SIZE=100

# Agent Runtime G21.5 exact synthetic Cron worker. This eleventh PostgreSQL
# principal inherits only agent_cron_worker. The independent profile stays off
# by default, binds one operator-reviewed Template and receives no Runner,
# object-store, Broker, Provider, vault, Redis or administrator credential.
AGENT_CRON_WORKER_ENABLED=false
AGENT_CRON_WORKER_DATABASE_URL=postgres://agent_cron_worker_app:change-me-agent-cron-worker-postgres@postgres:5432/neo_chat?sslmode=disable
AGENT_CRON_WORKER_PLAN_SOURCE=./secrets/agent-runtime-cron-worker/plan.json
AGENT_CRON_WORKER_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_CRON_WORKER_ACTIVATION_SOURCE=./secrets/agent-runtime-cron-worker/activation.json
AGENT_CRON_WORKER_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000

# Agent Runtime G21.5 exact quarantined Draft-learning worker. This twelfth
# PostgreSQL principal inherits only agent_learning_worker. The independent
# profile stays off by default, uses a distinct lifecycle-only Runner identity
# and keeps its S3-compatible cleanup credential out of Runner and Sandbox.
AGENT_DRAFT_LEARNING_WORKER_ENABLED=false
AGENT_DRAFT_LEARNING_WORKER_DATABASE_URL=postgres://agent_learning_worker_app:change-me-agent-learning-worker-postgres@postgres:5432/neo_chat?sslmode=disable
AGENT_DRAFT_LEARNING_WORKER_RUNNER_URL=https://127.0.0.1:9443/internal/neo-runner/v1/rpc
AGENT_DRAFT_LEARNING_WORKER_RUNNER_ID=neo-runner-primary
AGENT_DRAFT_LEARNING_WORKER_SERVER_NAME=neo-runner.internal
AGENT_DRAFT_LEARNING_WORKER_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-draft-learning
AGENT_DRAFT_LEARNING_WORKER_PLAN_SOURCE=./secrets/agent-runtime-draft-learning-worker/plan.json
AGENT_DRAFT_LEARNING_WORKER_CLIENT_CERT_SOURCE=./secrets/agent-runtime-draft-learning-worker/client.crt
AGENT_DRAFT_LEARNING_WORKER_CLIENT_KEY_SOURCE=./secrets/agent-runtime-draft-learning-worker/client.key
AGENT_DRAFT_LEARNING_WORKER_SERVER_CA_SOURCE=./secrets/agent-runtime-draft-learning-worker/server-ca.crt
AGENT_DRAFT_LEARNING_WORKER_AUTHORITY_PRIVATE_KEY_SOURCE=./secrets/agent-runtime-draft-learning-worker/authority-private-key
AGENT_DRAFT_LEARNING_WORKER_AUTHORITY_PUBLIC_KEY_SOURCE=./secrets/agent-runtime-draft-learning-worker/authority-public-key
AGENT_DRAFT_LEARNING_WORKER_RELEASE_MANIFEST_SOURCE=./secrets/agent-runtime-draft-learning-worker/release-manifest.json
AGENT_DRAFT_LEARNING_WORKER_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_DRAFT_LEARNING_WORKER_ACTIVATION_SOURCE=./secrets/agent-runtime-draft-learning-worker/activation.json
AGENT_DRAFT_LEARNING_WORKER_OBJECT_CREDENTIAL_META_SOURCE=./secrets/agent-runtime-draft-learning-worker/object-credential.json
AGENT_DRAFT_LEARNING_WORKER_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
AGENT_DRAFT_LEARNING_WORKER_OWNER=draft-learning-worker-primary
AGENT_DRAFT_LEARNING_WORKER_POLL_INTERVAL=10s
AGENT_DRAFT_LEARNING_WORKER_RPC_TIMEOUT=10s
AGENT_DRAFT_LEARNING_WORKER_LEASE_DURATION=2m
AGENT_DRAFT_LEARNING_WORKER_BATCH_SIZE=10
AGENT_DRAFT_LEARNING_WORKER_RETENTION=720h
AGENT_DRAFT_LEARNING_WORKER_MAINTENANCE_EVERY=60
AGENT_DRAFT_LEARNING_WORKER_S3_ACCESS_KEY_ID=change-me-draft-learning-access
AGENT_DRAFT_LEARNING_WORKER_S3_SECRET_ACCESS_KEY=change-me-draft-learning-secret

# Agent Runtime G21.6 bounded product canary. This thirteenth PostgreSQL
# principal inherits exactly agent_product_canary_worker,
# agent_orchestrator_runtime and agent_runner_control. The profile is off by
# default and accepts only the fixed smoke plan; it receives no generic prompt,
# Broker, Project, Child, Scheduler, Learning, Egress, Secret or object-store
# authority.
AGENT_PRODUCT_CANARY_ENABLED=false
AGENT_PRODUCT_CANARY_DATABASE_URL=postgres://agent_product_canary_app:change-me-agent-product-canary-postgres@postgres:5432/neo_chat?sslmode=disable
AGENT_PRODUCT_CANARY_ACTIVATION_ID=activation_replacewith16lowercasechars
AGENT_PRODUCT_CANARY_RUNNER_URL=https://127.0.0.1:9443/internal/neo-runner/v1/rpc
AGENT_PRODUCT_CANARY_RUNNER_ID=neo-runner-primary
AGENT_PRODUCT_CANARY_SERVER_NAME=neo-runner.internal
AGENT_PRODUCT_CANARY_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-product-canary
AGENT_PRODUCT_CANARY_CLIENT_CERT_SOURCE=./secrets/agent-runtime-product-canary/client.crt
AGENT_PRODUCT_CANARY_CLIENT_KEY_SOURCE=./secrets/agent-runtime-product-canary/client.key
AGENT_PRODUCT_CANARY_SERVER_CA_SOURCE=./secrets/agent-runtime-product-canary/server-ca.crt
AGENT_PRODUCT_CANARY_RELEASE_MANIFEST_SOURCE=./secrets/agent-runtime-product-canary/release-manifest.json
AGENT_PRODUCT_CANARY_PRODUCTION_POLICY_SOURCE=./config/agent-runner/production-policy.json
AGENT_PRODUCT_CANARY_ACTIVATION_SOURCE=./secrets/agent-runtime-product-canary/activation.json
AGENT_PRODUCT_CANARY_PLAN_SOURCE=./secrets/agent-runtime-product-canary/plan.json
AGENT_PRODUCT_CANARY_AUTHORITY_PRIVATE_KEY_SOURCE=./secrets/agent-runtime-product-canary/authority-private-key
AGENT_PRODUCT_CANARY_AUTHORITY_PUBLIC_KEY_SOURCE=./secrets/agent-runtime-product-canary/authority-public-key
AGENT_PRODUCT_CANARY_RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
AGENT_PRODUCT_CANARY_CLAIM_OWNER=product-canary-worker-primary
AGENT_PRODUCT_CANARY_POLL_INTERVAL=5s
AGENT_PRODUCT_CANARY_CLAIM_TTL=5m
AGENT_PRODUCT_CANARY_RPC_TIMEOUT=10s
AGENT_PRODUCT_CANARY_AUTHORITY_TTL=10s
AGENT_PRODUCT_CANARY_BATCH_SIZE=20

# Next.js frontend. The image is built in server mode and proxies same-origin
# /mm-api requests to the private Compose backend service.
FRONTEND_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat-frontend@sha256:replace-with-64-lowercase-hex
FRONTEND_PORT=3000
NEXT_PUBLIC_SITE_URL=https://change-me.example
# Use one single-quoted line with literal \n separators for a stable RSA PEM;
# production preflight rejects other quoting/escaping forms.
BYOK_PRIVATE_KEY_PEM=
BYOK_KEY_ID=
BYOK_ALLOW_EPHEMERAL_KEY=false
DEPLOYMENT_MODE=hosted
ALLOW_LOCAL_NETWORK_PROXY=
TRUST_PROXY_HEADERS=true
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phase 15.2B Python worker. Production requires an independently published
# immutable image digest. The long-running worker and operator-only replay path
# each use a dedicated Postgres login; neither receives another service's URL.
RAG_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat-rag@sha256:replace-with-64-lowercase-hex
RAG_WORKER_DATABASE_URL=postgres://rag_worker:change-me-rag-worker-postgres@postgres:5432/neo_chat?sslmode=disable
RAG_REPLAY_DATABASE_URL=postgres://rag_replay:change-me-rag-replay-postgres@postgres:5432/neo_chat?sslmode=disable
RAG_WORKER_DISPATCH_ENABLED=false
RAG_WORKER_JOB_STAGES=
RAG_SOURCE_GATEWAY_URL=http://backend:8080
RAG_SOURCE_GATEWAY_TOKEN=
RAG_PROVIDER_PROFILE=disabled
RAG_PROVIDER_PROFILE_DRAFT_WIRE_ACCEPTED=false
RAG_PROVIDER_RETRY_MAX_ATTEMPTS=3
RAG_PROVIDER_INITIAL_RETRY_SECONDS=30
RAG_PROVIDER_MAX_RETRY_SECONDS=300
RAG_PROVIDER_CONCURRENCY=2
RAG_MINERU_REQUESTS_PER_MINUTE=60
RAG_SILICONFLOW_REQUESTS_PER_MINUTE=240
RAG_SILICONFLOW_EMBEDDING_MODEL=Pro/BAAI/bge-m3
RAG_SILICONFLOW_RERANK_MODEL=Pro/BAAI/bge-reranker-v2-m3

# Redis temporary state. Keep REDIS_PASSWORD and REDIS_URL in sync.
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0
REDIS_KEY_PREFIX=mm-chat
REDIS_RUN_CANCEL_TTL=10m
REDIS_SESSION_CACHE_TTL=5m
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_REQUESTS=120
REDIS_RATE_LIMIT_WINDOW=1m

# Auth identity/session settings. Bootstrap User ID and Display Name must remain
# stable and are used only by the one-time `admin bootstrap-identity` command.
AUTH_MODE=required
AUTH_BOOTSTRAP_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_BOOTSTRAP_DISPLAY_NAME=Owner
AUTH_SESSION_TTL=168h
AUTH_RECOVERY_TTL=30m
AUTH_SMTP_ADDR=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_QUEUE_SIZE=100
AUTH_SMTP_TIMEOUT=10s

# Team cursor signing and encrypted durable Invite delivery. Replace both
# change-me values with independently generated base64-encoded 32-byte keys.
# These placeholders are intentionally not usable key material. Add old
# key-id=base64 entries after commas during verify/decrypt-only rotation.
TEAM_CURSOR_ACTIVE_KEY_ID=cursor-v1
TEAM_CURSOR_KEYRING=cursor-v1=change-me-base64-32-byte-random-key
TEAM_MAIL_ACTIVE_KEY_ID=mail-v1
TEAM_MAIL_KEYRING=mail-v1=change-me-base64-32-byte-random-key
TEAM_INVITE_ACCEPT_URL_BASE=https://change-me.example/invites/accept
TEAM_MAIL_WORKER_LEASE_DURATION=30s
TEAM_MAIL_WORKER_POLL_INTERVAL=500ms
TEAM_MAIL_WORKER_BACKOFF_BASE=5s
TEAM_MAIL_WORKER_BACKOFF_MAX=15m

# Model provider endpoints, models, and credentials are configured through the
# administrator Provider Settings page and stored in Postgres/vault.
PROVIDER_TIMEOUT=2m
PROVIDER_SECRET_KEYRING_SOURCE=./secrets/provider-keyring.json

# Live provider smoke tests are disabled unless all four values are explicitly
# set. Approval text is intentionally exact because these smokes can consume
# real provider quota. Targets are comma-separated kind:providerId:modelId
# entries such as image.generate:openai:gpt-image-1.
MM_CHAT_PROVIDER_LIVE_SMOKE_ENABLED=false
MM_CHAT_PROVIDER_LIVE_SMOKE_APPROVAL=
MM_CHAT_PROVIDER_LIVE_SMOKE_TARGETS=
MM_CHAT_PROVIDER_LIVE_SMOKE_RUN_ID=
MM_CHAT_PROVIDER_LIVE_SMOKE_OUTPUT_DIR=
MM_CHAT_PROVIDER_LIVE_SMOKE_BASE_URL=
MM_CHAT_PROVIDER_LIVE_SMOKE_API_KEY=
MM_CHAT_PROVIDER_LIVE_SMOKE_VOICE=
MM_CHAT_PROVIDER_LIVE_SMOKE_IMAGE_SIZE=

# Object storage. MinIO is private; only the Go API talks to it.
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./data/files
S3_ENDPOINT=http://minio:9000
S3_BUCKET=neo-chat-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mm-chat-files
S3_SECRET_ACCESS_KEY=change-me-minio-user-secret
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUTO_CREATE=false
MAX_UPLOAD_BYTES=52428800

# PostgreSQL 17 with the reviewed BM25/pgvector extensions. Production uses a
# fresh PG17 directory; never point this image at the retired PG16 PGDATA.
POSTGRES_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat-postgres@sha256:replace-with-64-lowercase-hex
POSTGRES_DATA_DIR=./data/postgres17

# Postgres container bootstrap. This principal is also the migration principal;
# keep POSTGRES_* and MIGRATION_DATABASE_URL synchronized. The API, worker,
# replay, and migrator URL credentials must all be distinct while sharing the
# same host and database. The Memory worker is a fifth distinct principal.
POSTGRES_DB=neo_chat
POSTGRES_USER=neo_chat_migrator
POSTGRES_PASSWORD=change-me-migrator-postgres
MIGRATION_DATABASE_URL=postgres://neo_chat_migrator:change-me-migrator-postgres@postgres:5432/neo_chat?sslmode=disable

# MinIO root bootstrap. Do not use these root credentials from the app.
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root-secret
