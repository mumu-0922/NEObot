# Copy to .env.single-server and replace every placeholder before production.
# Production preflight forbids `$` interpolation; use direct URL-safe/base64
# secret values and URL-encode database/Redis passwords inside their URLs.

# Go API
# Production requires a full registry digest. Local development may substitute
# a mutable tag for `docker compose build`, but it cannot pass preflight.
BACKEND_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat@sha256:replace-with-64-lowercase-hex
MM_CHAT_ADDR=:8080
MM_CHAT_VERSION=replace-with-release-id
# Compose file-backed secrets preserve host ownership and mode. Set these to
# the owner UID/GID of the mode-600 provider keyring (`id -u` / `id -g`).
MM_CHAT_RUNTIME_UID=replace-with-host-uid
MM_CHAT_RUNTIME_GID=replace-with-host-gid
DATABASE_URL=postgres://neo_chat_api:change-me-api-postgres@postgres:5432/neo_chat?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Next.js frontend. The image is built in server mode and proxies same-origin
# /mm-api requests to the private Compose backend service.
FRONTEND_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat-frontend@sha256:replace-with-64-lowercase-hex
FRONTEND_PORT=3000
NEXT_PUBLIC_SITE_URL=https://change-me.example
# Use one single-quoted line with literal \n separators for a stable RSA PEM;
# production preflight rejects other quoting/escaping forms.
BYOK_PRIVATE_KEY_PEM=
BYOK_KEY_ID=
BYOK_ALLOW_EPHEMERAL_KEY=false
DEPLOYMENT_MODE=hosted
ALLOW_LOCAL_NETWORK_PROXY=
TRUST_PROXY_HEADERS=true
RATE_LIMIT_STORE=memory
PLUGIN_REGISTRY_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phase 15.2B Python worker. Production requires an independently published
# immutable image digest. The long-running worker and operator-only replay path
# each use a dedicated Postgres login; neither receives another service's URL.
RAG_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat-rag@sha256:replace-with-64-lowercase-hex
RAG_WORKER_DATABASE_URL=postgres://rag_worker:change-me-rag-worker-postgres@postgres:5432/neo_chat?sslmode=disable
RAG_REPLAY_DATABASE_URL=postgres://rag_replay:change-me-rag-replay-postgres@postgres:5432/neo_chat?sslmode=disable
RAG_WORKER_DISPATCH_ENABLED=false
RAG_WORKER_JOB_STAGES=
RAG_SOURCE_GATEWAY_URL=http://backend:8080
RAG_SOURCE_GATEWAY_TOKEN=
RAG_PROVIDER_PROFILE=disabled
RAG_PROVIDER_PROFILE_DRAFT_WIRE_ACCEPTED=false
RAG_PROVIDER_RETRY_MAX_ATTEMPTS=3
RAG_PROVIDER_INITIAL_RETRY_SECONDS=30
RAG_PROVIDER_MAX_RETRY_SECONDS=300
RAG_PROVIDER_CONCURRENCY=2
RAG_MINERU_REQUESTS_PER_MINUTE=60
RAG_SILICONFLOW_REQUESTS_PER_MINUTE=240
RAG_SILICONFLOW_EMBEDDING_MODEL=Pro/BAAI/bge-m3
RAG_SILICONFLOW_RERANK_MODEL=Pro/BAAI/bge-reranker-v2-m3

# Redis temporary state. Keep REDIS_PASSWORD and REDIS_URL in sync.
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0
REDIS_KEY_PREFIX=mm-chat
REDIS_RUN_CANCEL_TTL=10m
REDIS_SESSION_CACHE_TTL=5m
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_REQUESTS=120
REDIS_RATE_LIMIT_WINDOW=1m

# Auth identity/session settings. Bootstrap User ID and Display Name must remain
# stable and are used only by the one-time `admin bootstrap-identity` command.
AUTH_MODE=required
AUTH_BOOTSTRAP_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_BOOTSTRAP_DISPLAY_NAME=Owner
AUTH_SESSION_TTL=168h
AUTH_RECOVERY_TTL=30m
AUTH_SMTP_ADDR=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_QUEUE_SIZE=100
AUTH_SMTP_TIMEOUT=10s

# Team cursor signing and encrypted durable Invite delivery. Replace both
# change-me values with independently generated base64-encoded 32-byte keys.
# These placeholders are intentionally not usable key material. Add old
# key-id=base64 entries after commas during verify/decrypt-only rotation.
TEAM_CURSOR_ACTIVE_KEY_ID=cursor-v1
TEAM_CURSOR_KEYRING=cursor-v1=change-me-base64-32-byte-random-key
TEAM_MAIL_ACTIVE_KEY_ID=mail-v1
TEAM_MAIL_KEYRING=mail-v1=change-me-base64-32-byte-random-key
TEAM_INVITE_ACCEPT_URL_BASE=https://change-me.example/invites/accept
TEAM_MAIL_WORKER_LEASE_DURATION=30s
TEAM_MAIL_WORKER_POLL_INTERVAL=500ms
TEAM_MAIL_WORKER_BACKOFF_BASE=5s
TEAM_MAIL_WORKER_BACKOFF_MAX=15m

# Model provider endpoints, models, and credentials are configured through the
# administrator Provider Settings page and stored in Postgres/vault.
PROVIDER_TIMEOUT=2m
PROVIDER_SECRET_KEYRING_SOURCE=./secrets/provider-keyring.json

# Live provider smoke tests are disabled unless all four values are explicitly
# set. Approval text is intentionally exact because these smokes can consume
# real provider quota. Targets are comma-separated kind:providerId:modelId
# entries such as image.generate:openai:gpt-image-1.
MM_CHAT_PROVIDER_LIVE_SMOKE_ENABLED=false
MM_CHAT_PROVIDER_LIVE_SMOKE_APPROVAL=
MM_CHAT_PROVIDER_LIVE_SMOKE_TARGETS=
MM_CHAT_PROVIDER_LIVE_SMOKE_RUN_ID=
MM_CHAT_PROVIDER_LIVE_SMOKE_OUTPUT_DIR=
MM_CHAT_PROVIDER_LIVE_SMOKE_BASE_URL=
MM_CHAT_PROVIDER_LIVE_SMOKE_API_KEY=
MM_CHAT_PROVIDER_LIVE_SMOKE_VOICE=
MM_CHAT_PROVIDER_LIVE_SMOKE_IMAGE_SIZE=

# Object storage. MinIO is private; only the Go API talks to it.
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./data/files
S3_ENDPOINT=http://minio:9000
S3_BUCKET=neo-chat-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mm-chat-files
S3_SECRET_ACCESS_KEY=change-me-minio-user-secret
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUTO_CREATE=false
MAX_UPLOAD_BYTES=52428800

# PostgreSQL 17 with the reviewed BM25/pgvector extensions. Production uses a
# fresh PG17 directory; never point this image at the retired PG16 PGDATA.
POSTGRES_IMAGE=ghcr.io/mumu-0922/neobot-mm-chat-postgres@sha256:replace-with-64-lowercase-hex
POSTGRES_DATA_DIR=./data/postgres17

# Postgres container bootstrap. This principal is also the migration principal;
# keep POSTGRES_* and MIGRATION_DATABASE_URL synchronized. The API, worker,
# replay, and migrator URL credentials must all be distinct while sharing the
# same host and database.
POSTGRES_DB=neo_chat
POSTGRES_USER=neo_chat_migrator
POSTGRES_PASSWORD=change-me-migrator-postgres
MIGRATION_DATABASE_URL=postgres://neo_chat_migrator:change-me-migrator-postgres@postgres:5432/neo_chat?sslmode=disable

# MinIO root bootstrap. Do not use these root credentials from the app.
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root-secret
