{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mm-chat.invalid/parser/parser-corpus-manifest.v1.schema.json",
  "title": "MM Chat offline parser corpus manifest v1",
  "description": "Closed hash ledger for the checked-in parser corpus. Provenance distinguishes project-authored synthetic bytes, deterministic generated bytes, and upstream bytes so repository licensing is never presented as third-party licensing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries",
    "aggregateHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "parser-corpus-manifest.v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "aggregateHash": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "relativePath": {
      "allOf": [
        {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonEmptyUnicodeScalarString"
        },
        {
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//).+$"
        }
      ]
    },
    "role": {
      "enum": [
        "golden",
        "adversarial",
        "recipe"
      ]
    },
    "projectSyntheticProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "project_synthetic"
        }
      }
    },
    "generatedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "generated"
        }
      }
    },
    "upstreamRights": {
      "oneOf": [
        {
          "$ref": "#/$defs/spdxLicense"
        },
        {
          "$ref": "#/$defs/nonSpdxLicense"
        },
        {
          "$ref": "#/$defs/publicDomain"
        },
        {
          "$ref": "#/$defs/explicitPermission"
        }
      ]
    },
    "spdxLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spdxExpression",
        "evidenceUrl"
      ],
      "properties": {
        "kind": {
          "const": "spdx_license"
        },
        "spdxExpression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9.+() -]+$"
        },
        "evidenceUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "nonSpdxLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "licenseName",
        "licenseUrl"
      ],
      "properties": {
        "kind": {
          "const": "non_spdx_license"
        },
        "licenseName": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonEmptyUnicodeScalarString"
        },
        "licenseUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "publicDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidenceUrl"
      ],
      "properties": {
        "kind": {
          "const": "public_domain"
        },
        "evidenceUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "explicitPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "permissionSummary",
        "evidenceUrl"
      ],
      "properties": {
        "kind": {
          "const": "explicit_permission"
        },
        "permissionSummary": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonEmptyUnicodeScalarString"
        },
        "evidenceUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "upstreamProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceUrl",
        "rights",
        "redistributionBasis"
      ],
      "properties": {
        "kind": {
          "const": "upstream"
        },
        "sourceUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "rights": {
          "$ref": "#/$defs/upstreamRights"
        },
        "redistributionBasis": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonEmptyUnicodeScalarString"
        }
      }
    },
    "httpsUrl": {
      "allOf": [
        {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonEmptyUnicodeScalarString"
        },
        {
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$"
        }
      ]
    },
    "projectSyntheticEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "rawBytes",
        "rawSha256",
        "provenance"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "rawBytes": {
          "$ref": "canonical-common.v1.schema.json#/$defs/byteCount"
        },
        "rawSha256": {
          "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
        },
        "provenance": {
          "$ref": "#/$defs/projectSyntheticProvenance"
        }
      }
    },
    "generatedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "rawBytes",
        "rawSha256",
        "recipePath",
        "provenance"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "role": {
          "enum": [
            "golden",
            "adversarial"
          ]
        },
        "rawBytes": {
          "$ref": "canonical-common.v1.schema.json#/$defs/byteCount"
        },
        "rawSha256": {
          "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
        },
        "recipePath": {
          "$ref": "#/$defs/relativePath"
        },
        "provenance": {
          "$ref": "#/$defs/generatedProvenance"
        }
      }
    },
    "upstreamEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "rawBytes",
        "rawSha256",
        "provenance"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "role": {
          "enum": [
            "golden",
            "adversarial"
          ]
        },
        "rawBytes": {
          "$ref": "canonical-common.v1.schema.json#/$defs/byteCount"
        },
        "rawSha256": {
          "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
        },
        "provenance": {
          "$ref": "#/$defs/upstreamProvenance"
        }
      }
    },
    "entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/projectSyntheticEntry"
        },
        {
          "$ref": "#/$defs/generatedEntry"
        },
        {
          "$ref": "#/$defs/upstreamEntry"
        }
      ]
    }
  }
}
