{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mm-chat.invalid/parser/source-locator.v2.schema.json",
  "title": "Source locator set v2",
  "description": "Closed canonical locator set separating non-empty canonical text anchors from structural-only anchors. Fragment order is source reading order; view order is source_text_position, page_region, slide_shape, sheet_range, ooxml_path, derived_structure. Byte-level loading requires strict UTF-8 RFC 8785 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "textAnchors",
    "structuralAnchors",
    "aggregateHash"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "textAnchors": {
      "type": "array",
      "description": "Strictly increasing, non-overlapping canonical UTF-8 byte ranges with contiguous anchor ordinals from zero.",
      "items": {
        "$ref": "#/$defs/textAnchor"
      }
    },
    "structuralAnchors": {
      "type": "array",
      "description": "Canonical order is structureOrdinal, frozen nodeKind rank, then ownerSeedId; ordinals are contiguous from zero.",
      "items": {
        "$ref": "#/$defs/structuralAnchor"
      }
    },
    "aggregateHash": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    }
  },
  "anyOf": [
    {
      "properties": {
        "textAnchors": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "structuralAnchors": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "textAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorOrdinal",
        "canonicalStartByte",
        "canonicalEndByte",
        "sourceFragments"
      ],
      "properties": {
        "anchorOrdinal": {
          "$ref": "canonical-common.v1.schema.json#/$defs/ordinal"
        },
        "canonicalStartByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "canonicalEndByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/positiveByteCount"
        },
        "sourceFragments": {
          "$ref": "#/$defs/sourceFragments"
        }
      }
    },
    "structuralAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorOrdinal",
        "nodeKind",
        "ownerSeedId",
        "structureOrdinal",
        "sourceFragments"
      ],
      "properties": {
        "anchorOrdinal": {
          "$ref": "canonical-common.v1.schema.json#/$defs/ordinal"
        },
        "nodeKind": {
          "$ref": "#/$defs/structuralNodeKind"
        },
        "ownerSeedId": {
          "$ref": "canonical-common.v1.schema.json#/$defs/opaqueId"
        },
        "structureOrdinal": {
          "$ref": "canonical-common.v1.schema.json#/$defs/ordinal"
        },
        "sourceFragments": {
          "$ref": "#/$defs/sourceFragments"
        }
      }
    },
    "structuralNodeKind": {
      "description": "Rank is the zero-based position in this frozen list.",
      "enum": [
        "document",
        "page",
        "heading",
        "paragraph",
        "list",
        "list_item",
        "quote",
        "code",
        "table",
        "table_row",
        "table_cell",
        "formula",
        "caption",
        "footnote",
        "header",
        "footer",
        "page_break",
        "asset_ref",
        "slide",
        "sheet",
        "shape"
      ]
    },
    "sourceFragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceFragment"
      }
    },
    "sourceFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentOrdinal",
        "views"
      ],
      "properties": {
        "fragmentOrdinal": {
          "$ref": "canonical-common.v1.schema.json#/$defs/ordinal"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "description": "Views are sorted by frozen kind rank and each kind appears at most once in one fragment.",
          "items": {
            "$ref": "#/$defs/view"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "source_text_position"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "page_region"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "slide_shape"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "sheet_range"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "ooxml_path"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "derived_structure"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "view": {
      "oneOf": [
        {
          "$ref": "#/$defs/sourceTextPositionView"
        },
        {
          "$ref": "#/$defs/pageRegionView"
        },
        {
          "$ref": "#/$defs/slideShapeView"
        },
        {
          "$ref": "#/$defs/sheetRangeView"
        },
        {
          "$ref": "#/$defs/ooxmlPathView"
        },
        {
          "$ref": "#/$defs/derivedStructureView"
        }
      ]
    },
    "sourceTextPositionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "opaqueSourceUnitId",
        "rawByteStart",
        "rawByteEnd",
        "decodedScalarStart",
        "decodedScalarEnd",
        "startLine",
        "startColumn",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "kind": {
          "const": "source_text_position"
        },
        "opaqueSourceUnitId": {
          "$ref": "canonical-common.v1.schema.json#/$defs/opaqueId"
        },
        "rawByteStart": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "rawByteEnd": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "decodedScalarStart": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
        },
        "decodedScalarEnd": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
        },
        "startLine": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
        },
        "startColumn": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
        },
        "endLine": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
        },
        "endColumn": {
          "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
        }
      }
    },
    "pageRegionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pageIndex",
        "bboxMilliPoint"
      ],
      "properties": {
        "kind": {
          "const": "page_region"
        },
        "pageIndex": {
          "$ref": "canonical-common.v1.schema.json#/$defs/ordinal"
        },
        "bboxMilliPoint": {
          "$ref": "canonical-common.v1.schema.json#/$defs/bboxMilliPoint"
        }
      }
    },
    "slideShapeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "slideIndex",
        "opaqueShapeId"
      ],
      "properties": {
        "kind": {
          "const": "slide_shape"
        },
        "slideIndex": {
          "$ref": "canonical-common.v1.schema.json#/$defs/ordinal"
        },
        "opaqueShapeId": {
          "$ref": "canonical-common.v1.schema.json#/$defs/opaqueId"
        },
        "bboxMilliPoint": {
          "$ref": "canonical-common.v1.schema.json#/$defs/bboxMilliPoint"
        }
      }
    },
    "sheetRangeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "opaqueSheetId",
        "startCell",
        "endCell"
      ],
      "properties": {
        "kind": {
          "const": "sheet_range"
        },
        "opaqueSheetId": {
          "$ref": "canonical-common.v1.schema.json#/$defs/opaqueId"
        },
        "startCell": {
          "$ref": "#/$defs/a1Cell"
        },
        "endCell": {
          "$ref": "#/$defs/a1Cell"
        }
      }
    },
    "ooxmlPathView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "opaqueSourceUnitId",
        "canonicalXPathPayloadRef"
      ],
      "properties": {
        "kind": {
          "const": "ooxml_path"
        },
        "opaqueSourceUnitId": {
          "$ref": "canonical-common.v1.schema.json#/$defs/opaqueId"
        },
        "canonicalXPathPayloadRef": {
          "$ref": "canonical-common.v1.schema.json#/$defs/payloadRef"
        }
      }
    },
    "derivedStructureView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "structureKind",
        "opaqueStructureId"
      ],
      "properties": {
        "kind": {
          "const": "derived_structure"
        },
        "structureKind": {
          "$ref": "#/$defs/structuralNodeKind"
        },
        "opaqueStructureId": {
          "$ref": "canonical-common.v1.schema.json#/$defs/opaqueId"
        }
      }
    },
    "a1Cell": {
      "type": "string",
      "pattern": "^[A-Z]+[1-9][0-9]*$"
    }
  }
}
