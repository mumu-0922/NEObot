{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mm-chat.invalid/parser/quality-report.v2.schema.json",
  "title": "Offline parser quality report v2",
  "description": "Closed, content-free quality decision. Gate records are fixed in Source, Safety, Structure, Text, Spatial, Locator, Chunk, Determinism, Manifest order; only bounded counts, booleans, stable errors, and hashes are admitted.",
