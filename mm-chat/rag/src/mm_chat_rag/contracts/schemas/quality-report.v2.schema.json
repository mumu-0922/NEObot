    {
      "$ref": "#/$defs/acceptedReport"
    },
    {
      "$ref": "#/$defs/routeRequiredReport"
    },
    {
      "$ref": "#/$defs/quarantinedReport"
    },
    {
      "$ref": "#/$defs/unsupportedReport"
    }
  ],
  "$defs": {
