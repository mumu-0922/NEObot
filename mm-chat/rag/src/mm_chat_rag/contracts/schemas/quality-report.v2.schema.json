      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceSha256",
        "normalizationProfileHash",
        "parserProfileHash",
        "outcome",
        "gateResults",
        "metrics",
        "artifactHashes",
        "stableError"
      ],
      "properties": {
        "schemaVersion": {
          "const": "quality-report.v2"
        },
        "sourceSha256": {
          "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
        },
        "normalizationProfileHash": {
          "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
        },
        "parserProfileHash": {
          "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
        },
        "outcome": {
          "const": "accepted"
        },
        "gateResults": {
          "$ref": "#/$defs/acceptedGateResults"
        },
        "metrics": {
          "$ref": "#/$defs/acceptedMetrics"
        },
        "artifactHashes": {
          "$ref": "#/$defs/completeArtifactHashes"
        },
        "stableError": {
          "type": "null"
        }
      }
    },
    "routeRequiredReport": {
      "type": "object",
      "additionalProperties": false,
