        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "artifactHashes": {
          "$ref": "#/$defs/emptyArtifactHashes"
        },
        "stableError": {
          "$ref": "#/$defs/mineruRequiredError"
        }
      }
    },
    "quarantinedReport": {
