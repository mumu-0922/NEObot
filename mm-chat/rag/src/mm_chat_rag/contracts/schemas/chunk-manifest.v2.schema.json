{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mm-chat.invalid/parser/chunk-manifest.v2.schema.json",
  "title": "MM Chat parent child chunk manifest v2",
  "description": "Closed parent/child chunk ledger. Array order is semantic. Cross-record validators prove contiguous ordinals, n-1 joiners, flow membership, parent containment, overlap adjacency, byte bounds, reconstruction hashes, and aggregate hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSha256",
    "chunkProfileHash",
    "parents",
    "children",
    "parentCount",
    "childCount",
    "spanCount",
    "joinerCount",
    "parentAggregateHash",
    "childAggregateHash",
    "spanAggregateHash",
    "joinerAggregateHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "chunk-manifest.v2"
    },
    "sourceSha256": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    },
    "chunkProfileHash": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    },
    "parents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parentChunk"
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/childChunk"
      }
    },
    "parentCount": {
      "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
    },
    "childCount": {
      "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
    },
    "spanCount": {
      "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
    },
    "joinerCount": {
      "$ref": "canonical-common.v1.schema.json#/$defs/nonNegativeSafeInteger"
    },
    "parentAggregateHash": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    },
    "childAggregateHash": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    },
    "spanAggregateHash": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    },
    "joinerAggregateHash": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "$ref": "canonical-common.v1.schema.json#/$defs/sha256"
    },
    "ordinal": {
      "$ref": "canonical-common.v1.schema.json#/$defs/ordinal"
    },
    "positiveSafeInteger": {
      "$ref": "canonical-common.v1.schema.json#/$defs/positiveSafeInteger"
    },
    "primaryFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentKind",
        "blockLogicalId",
        "blockStartByte",
        "blockEndByte",
        "clippedLocatorSet",
        "fragmentSourceSpanHash"
      ],
      "properties": {
        "fragmentKind": {
          "const": "primary"
        },
        "blockLogicalId": {
          "$ref": "#/$defs/sha256"
        },
        "blockStartByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "blockEndByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "clippedLocatorSet": {
          "$ref": "source-locator.v2.schema.json"
        },
        "fragmentSourceSpanHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowOverlapFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentKind",
        "blockLogicalId",
        "blockStartByte",
        "blockEndByte",
        "clippedLocatorSet",
        "fragmentSourceSpanHash",
        "previousChildOrdinal",
        "overlapGroupId",
        "overlapTokenCount"
      ],
      "properties": {
        "fragmentKind": {
          "const": "window_overlap"
        },
        "blockLogicalId": {
          "$ref": "#/$defs/sha256"
        },
        "blockStartByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "blockEndByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "clippedLocatorSet": {
          "$ref": "source-locator.v2.schema.json"
        },
        "fragmentSourceSpanHash": {
          "$ref": "#/$defs/sha256"
        },
        "previousChildOrdinal": {
          "$ref": "#/$defs/ordinal"
        },
        "overlapGroupId": {
          "$ref": "#/$defs/sha256"
        },
        "overlapTokenCount": {
          "type": "integer",
          "minimum": 60,
          "maximum": 100
        }
      }
    },
    "derivedContextFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentKind",
        "blockLogicalId",
        "blockStartByte",
        "blockEndByte",
        "clippedLocatorSet",
        "fragmentSourceSpanHash",
        "derived",
        "derivedReason",
        "sourceReuseGroupId",
        "originalFragmentSourceSpanHash"
      ],
      "properties": {
        "fragmentKind": {
          "const": "derived_context"
        },
        "blockLogicalId": {
          "$ref": "#/$defs/sha256"
        },
        "blockStartByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "blockEndByte": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8ByteOffset"
        },
        "clippedLocatorSet": {
          "$ref": "source-locator.v2.schema.json"
        },
        "fragmentSourceSpanHash": {
          "$ref": "#/$defs/sha256"
        },
        "derived": {
          "const": true
        },
        "derivedReason": {
          "enum": [
            "table_header",
            "heading_context",
            "faq_context",
            "code_signature",
            "json_path",
            "sheet_header",
            "slide_title"
          ]
        },
        "sourceReuseGroupId": {
          "$ref": "#/$defs/sha256"
        },
        "originalFragmentSourceSpanHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parentSpanFragment": {
      "oneOf": [
        {
          "$ref": "#/$defs/primaryFragment"
        },
        {
          "$ref": "#/$defs/derivedContextFragment"
        }
      ]
    },
    "childSpanFragment": {
      "oneOf": [
        {
          "$ref": "#/$defs/primaryFragment"
        },
        {
          "$ref": "#/$defs/windowOverlapFragment"
        },
        {
          "$ref": "#/$defs/derivedContextFragment"
        }
      ]
    },
    "joiner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "utf8Bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "adjacent",
            "block_separator"
          ]
        },
        "utf8Bytes": {
          "$ref": "canonical-common.v1.schema.json#/$defs/utf8BytesString"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "adjacent"
            },
            "utf8Bytes": {
              "const": ""
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "block_separator"
            },
            "utf8Bytes": {
              "const": "\n\n"
            }
          }
        }
      ]
    },
    "parentChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunkKind",
        "logicalChunkId",
        "logicalFlowId",
        "parentChunkSeedId",
        "sectionOwnerSeedId",
        "parentOrdinal",
        "chunkProfileHash",
        "tokenCount",
        "contentBytes",
        "contentHash",
        "chunkSourceSpanHash",
        "spanFragments",
        "joiners"
      ],
      "properties": {
        "chunkKind": {
          "const": "parent"
        },
        "logicalChunkId": {
          "$ref": "#/$defs/sha256"
        },
        "logicalFlowId": {
          "$ref": "#/$defs/sha256"
        },
        "parentChunkSeedId": {
          "$ref": "#/$defs/sha256"
        },
        "sectionOwnerSeedId": {
          "$ref": "#/$defs/sha256"
        },
        "parentOrdinal": {
          "$ref": "#/$defs/ordinal"
        },
        "chunkProfileHash": {
          "$ref": "#/$defs/sha256"
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "contentBytes": {
          "$ref": "canonical-common.v1.schema.json#/$defs/positiveByteCount"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "chunkSourceSpanHash": {
          "$ref": "#/$defs/sha256"
        },
        "spanFragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parentSpanFragment"
          }
        },
        "joiners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/joiner"
          }
        }
      }
    },
    "childChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunkKind",
        "logicalChunkId",
        "logicalParentChunkId",
        "logicalFlowId",
        "parentChunkSeedId",
        "childOrdinal",
        "chunkProfileHash",
        "tokenCount",
        "contentBytes",
        "contentHash",
        "chunkSourceSpanHash",
        "spanFragments",
        "joiners"
      ],
      "properties": {
        "chunkKind": {
          "const": "child"
        },
        "logicalChunkId": {
          "$ref": "#/$defs/sha256"
        },
        "logicalParentChunkId": {
          "$ref": "#/$defs/sha256"
        },
        "logicalFlowId": {
          "$ref": "#/$defs/sha256"
        },
        "parentChunkSeedId": {
          "$ref": "#/$defs/sha256"
        },
        "childOrdinal": {
          "$ref": "#/$defs/ordinal"
        },
        "chunkProfileHash": {
          "$ref": "#/$defs/sha256"
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 650
        },
        "contentBytes": {
          "$ref": "canonical-common.v1.schema.json#/$defs/positiveByteCount"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "chunkSourceSpanHash": {
          "$ref": "#/$defs/sha256"
        },
        "spanFragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/childSpanFragment"
          }
        },
        "joiners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/joiner"
          }
        }
      }
    }
  }
}
