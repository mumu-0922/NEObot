MM_CHAT_ADDR=:8080
MM_CHAT_VERSION=dev

# Empty DATABASE_URL keeps the API in DB-disabled development mode.
# Set this before running chat CRUD or streaming endpoints.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/mm_chat?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Redis temporary state. Empty REDIS_URL disables Redis. Redis is non-authoritative:
# Postgres remains the source of truth for conversations, messages, files, and runs.
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
REDIS_KEY_PREFIX=mm-chat
REDIS_RUN_CANCEL_TTL=10m
REDIS_SESSION_CACHE_TTL=5m
REDIS_RATE_LIMIT_ENABLED=false
REDIS_RATE_LIMIT_REQUESTS=120
REDIS_RATE_LIMIT_WINDOW=1m

# Auth identity/session settings. Bootstrap User ID and Display Name must remain
# stable and are used only by the one-time `admin bootstrap-identity` command.
AUTH_MODE=development
AUTH_BOOTSTRAP_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_BOOTSTRAP_DISPLAY_NAME=Owner
AUTH_SESSION_TTL=168h
AUTH_RECOVERY_TTL=30m
AUTH_SMTP_ADDR=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_QUEUE_SIZE=100
AUTH_SMTP_TIMEOUT=10s

# Team pagination and durable Invite mail. Blank values keep these development
# features disabled. Configure independent random keys before exercising Team
# pagination or Invite delivery; keyrings use comma-separated key-id=base64
# entries and retained non-active entries are verify/decrypt-only.
TEAM_CURSOR_ACTIVE_KEY_ID=local-dev
TEAM_CURSOR_KEYRING=local-dev=bW0tY2hhdC1sb2NhbC1kZXYtY3Vyc29yLWtleS0zMi1ieXRlcw==
TEAM_MAIL_ACTIVE_KEY_ID=
TEAM_MAIL_KEYRING=
TEAM_INVITE_ACCEPT_URL_BASE=
TEAM_MAIL_WORKER_LEASE_DURATION=30s
TEAM_MAIL_WORKER_POLL_INTERVAL=500ms
TEAM_MAIL_WORKER_BACKOFF_BASE=5s
TEAM_MAIL_WORKER_BACKOFF_MAX=15m

# OpenAI-compatible relay/provider.
PROVIDER_TYPE=openai_compatible
DEFAULT_PROVIDER_NAME=Server Default
PROVIDER_BASE_URL=https://your-openai-compatible-relay.example/v1
PROVIDER_MODEL=gpt-5.5
PROVIDER_API_KEY=change-me
PROVIDER_TIMEOUT=2m

# Live provider smoke tests are disabled unless all four values are explicitly
# set. Approval text is intentionally exact because these smokes can consume
# real provider quota. Targets are comma-separated kind:providerId:modelId
# entries such as image.generate:openai:gpt-image-1.
MM_CHAT_PROVIDER_LIVE_SMOKE_ENABLED=false
MM_CHAT_PROVIDER_LIVE_SMOKE_APPROVAL=
MM_CHAT_PROVIDER_LIVE_SMOKE_TARGETS=
MM_CHAT_PROVIDER_LIVE_SMOKE_RUN_ID=
MM_CHAT_PROVIDER_LIVE_SMOKE_OUTPUT_DIR=
MM_CHAT_PROVIDER_LIVE_SMOKE_IMAGE_SIZE=

# Browser BYOK public-key publication for encrypted user-entered secrets.
# Leave the private key empty in development only if BYOK_ALLOW_EPHEMERAL_KEY=true.
BYOK_PRIVATE_KEY_PEM=
BYOK_KEY_ID=
BYOK_ALLOW_EPHEMERAL_KEY=false

# File-byte storage. Use local for dev fallback, minio for single-server MinIO,
# or s3 for an S3-compatible remote backend.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/files
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=neo-chat-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUTO_CREATE=false
MAX_UPLOAD_BYTES=26214400

# G7 Knowledge/RAG automatic indexing provider credentials. These are
# administrator-owned server secrets for background MinerU/Jina work; leave
# blank until enabling the G7 provider-backed RAG slices.
RAG_MINERU_API_TOKEN=
RAG_JINA_API_KEY=
