[Unit]
Description=Neo rootless Agent Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neo-runner
Group=neo-runner
EnvironmentFile=/etc/neo-runner/neo-runnerd.env
ExecStart=/opt/neo-runner/bin/neo-runnerd
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
Delegate=yes
# newuidmap/newgidmap are the reviewed setuid helpers required to create the
# 65536-ID rootless user namespace. NNP here would silently disable them. The
# Sandbox itself is still inspected for no-new-privileges before start.
NoNewPrivileges=no
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
# Rootless OCI needs write access to this service's delegated cgroup subtree.
# Delegate=yes is the containment boundary; ProtectControlGroups=yes would make
# the delegation unusable.
ProtectControlGroups=no
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Allow only the namespace kinds required by rootless OCI. A blanket `yes`
# denies every namespace creation and makes rootless Podman fail after probe.
RestrictNamespaces=cgroup ipc net mnt pid user uts
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# The daemon starts with no capabilities. Only reviewed uid/gid mapping helpers
# may acquire these two capabilities through their pinned setuid executables.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
ReadWritePaths=/var/lib/neo-runner /run/neo-runner
UMask=0077

[Install]
WantedBy=multi-user.target
