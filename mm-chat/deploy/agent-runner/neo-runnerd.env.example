NEO_RUNNER_LISTEN_ADDR=127.0.0.1:9443
NEO_RUNNER_CLIENT_IDENTITY=spiffe://neo-chat/agent-runtime-control
NEO_RUNNER_ROOT_CANARY_CLIENT_IDENTITY=
NEO_RUNNER_BROKER_CANARY_CLIENT_IDENTITY=
NEO_RUNNER_BROKER_RELAY_URL=
NEO_RUNNER_BROKER_RELAY_CLIENT_CERT_FILE=
NEO_RUNNER_BROKER_RELAY_CLIENT_KEY_FILE=
NEO_RUNNER_BROKER_RELAY_SERVER_CA_FILE=
NEO_RUNNER_BROKER_RELAY_SERVER_NAME=
NEO_RUNNER_BROKER_RELAY_CLIENT_IDENTITY=
NEO_RUNNER_PROJECT_CANARY_CLIENT_IDENTITY=
NEO_RUNNER_PROJECT_RELAY_URL=
NEO_RUNNER_PROJECT_RELAY_CLIENT_CERT_FILE=
NEO_RUNNER_PROJECT_RELAY_CLIENT_KEY_FILE=
NEO_RUNNER_PROJECT_RELAY_SERVER_CA_FILE=
NEO_RUNNER_PROJECT_RELAY_SERVER_NAME=
NEO_RUNNER_PROJECT_RELAY_CLIENT_IDENTITY=
NEO_RUNNER_STATE_ROOT=/var/lib/neo-runner
NEO_RUNNER_RELEASE_MANIFEST=/etc/neo-runner/release-manifest.json
NEO_RUNNER_AUTHORITY_PUBLIC_KEY_FILE=/etc/neo-runner/authority-public-key
NEO_RUNNER_TLS_CERT_FILE=/etc/neo-runner/tls/runner.crt
NEO_RUNNER_TLS_KEY_FILE=/etc/neo-runner/tls/runner.key
NEO_RUNNER_TLS_CLIENT_CA_FILE=/etc/neo-runner/tls/client-ca.crt
