{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "synthetic",
    "userId",
    "projectId",
    "assistantId",
    "packageFingerprint",
    "runtimeBundleFingerprint",
    "targetFingerprint",
    "issuedAt",
    "expiresAt",
    "sandbox",
    "argv",
    "leaseSeconds",
    "action"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-project-mutation-canary-plan/v1"
    },
    "synthetic": {
      "const": true
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "pattern": "^project_[A-Za-z0-9_-]{8,128}$"
    },
    "assistantId": {
      "type": "string",
      "pattern": "^assistant_[A-Za-z0-9_-]{8,128}$"
    },
    "packageFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "runtimeBundleFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "targetFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "issuedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/timestamp"
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeBundleFingerprint",
        "packageFingerprint",
        "image",
        "uid",
        "gid",
        "rootfsReadOnly",
        "noNewPrivileges",
        "capabilities",
        "seccompProfileFingerprint",
        "networkMode",
        "workspaceSnapshotId",
        "workspaceFingerprint",
        "resources"
      ],
      "properties": {
        "runtimeBundleFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "packageFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "gid": {
          "type": "integer",
          "minimum": 1
        },
        "rootfsReadOnly": {
          "const": true
        },
        "noNewPrivileges": {
          "const": true
        },
        "capabilities": {
          "const": []
        },
        "seccompProfileFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "networkMode": {
          "const": "none"
        },
        "workspaceSnapshotId": {
          "type": "string",
          "pattern": "^workspace_snapshot_[A-Za-z0-9_-]{8,128}$"
        },
        "workspaceFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpuMillis",
            "memoryMiB",
            "pids",
            "wallSeconds",
            "outputBytes",
            "scratchBytes"
          ],
          "properties": {
            "cpuMillis": {
              "type": "integer",
              "minimum": 1
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 1
            },
            "pids": {
              "type": "integer",
              "minimum": 1
            },
            "wallSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "scratchBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "leaseSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requestIdentity",
        "idempotencyKey",
        "toolIdentity",
        "capability",
        "action",
        "resource",
        "classification",
        "idempotent",
        "approval",
        "arguments",
        "baseRevision",
        "ttlSeconds",
        "project"
      ],
      "properties": {
        "id": {
          "const": "project_mutation"
        },
        "requestIdentity": {
          "type": "string",
          "pattern": "^g21\\.3-request-[a-z0-9][a-z0-9._-]{7,79}$"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^g21\\.3-project-mutation-[a-z0-9][a-z0-9._-]{7,79}$"
        },
        "toolIdentity": {
          "const": "project.patch"
        },
        "capability": {
          "const": "project.write"
        },
        "action": {
          "const": "apply_patch"
        },
        "resource": {
          "type": "string",
          "pattern": "^project-canary/[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "classification": {
          "const": "mutable"
        },
        "idempotent": {
          "const": false
        },
        "approval": {
          "const": "per_commit"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentFingerprint",
            "mutationFingerprint",
            "path",
            "sizeBytes"
          ],
          "properties": {
            "contentFingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "mutationFingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "baseRevision": {
          "$ref": "#/$defs/fingerprint"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource",
            "path",
            "baseRevision",
            "content",
            "maxBytes"
          ],
          "properties": {
            "resource": {
              "type": "string",
              "pattern": "^project-canary/[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "baseRevision": {
              "$ref": "#/$defs/fingerprint"
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-agent-project-mutation-canary-plan.schema.json",
  "title": "Neo Agent Project Mutation Canary Plan",
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "description": "Strict G21.3 single-action synthetic Project CAS plan."
}
