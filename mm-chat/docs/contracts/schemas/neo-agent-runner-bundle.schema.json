{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/contracts/neo-agent-runner-bundle.schema.json",
  "title": "Neo Agent Runner exact-host bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "release",
    "files",
    "inventorySha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-runner-bundle/v1"
    },
    "evidenceClass": {
      "enum": ["template", "production"]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "migrationHead",
        "goVersion",
        "targetOS",
        "targetArch"
      ],
      "properties": {
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migrationHead": {
          "const": 93
        },
        "goVersion": {
          "type": "string",
          "pattern": "^go1\\.25(\\.[0-9]+)?$"
        },
        "targetOS": {
          "const": "linux"
        },
        "targetArch": {
          "enum": ["amd64", "arm64"]
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
          },
          "mode": {
            "enum": ["0644", "0755"]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "inventorySha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
