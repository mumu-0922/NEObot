{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-skill-draft.schema.json",
  "title": "Neo Skill Learning Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceRunId",
    "sourceSnapshotId",
    "sourceSnapshotFingerprint",
    "basePackageFingerprint",
    "proposedPackageFingerprint",
    "runtimeBundleFingerprint",
    "sbomFingerprint",
    "archiveFingerprint",
    "evidenceFingerprint",
    "testFingerprint",
    "name",
    "version",
    "archiveBytes",
    "evidence",
    "tests",
    "changedPaths"
  ],
  "properties": {
    "schemaVersion": { "const": "neo.skill-draft/v1" },
    "sourceRunId": { "type": "string", "pattern": "^run_[a-z0-9]{16,64}$" },
    "sourceSnapshotId": {
      "type": "string",
      "pattern": "^snapshot_[a-z0-9]{16,64}$"
    },
    "sourceSnapshotFingerprint": { "$ref": "#/$defs/fingerprint" },
    "basePackageFingerprint": { "$ref": "#/$defs/fingerprint" },
    "proposedPackageFingerprint": { "$ref": "#/$defs/fingerprint" },
    "runtimeBundleFingerprint": { "$ref": "#/$defs/fingerprint" },
    "sbomFingerprint": { "$ref": "#/$defs/fingerprint" },
    "archiveFingerprint": { "$ref": "#/$defs/fingerprint" },
    "evidenceFingerprint": { "$ref": "#/$defs/fingerprint" },
    "testFingerprint": { "$ref": "#/$defs/fingerprint" },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "archiveBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "properties": { "kind": { "const": "source_package" } },
        "required": ["kind"]
      },
      "minContains": 1,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "run_event" } },
            "required": ["kind"]
          },
          "minContains": 1
        }
      ],
      "items": { "$ref": "#/$defs/evidence" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/testFile" }
    },
    "changedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safePath" }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "fingerprint", "paths"],
      "properties": {
        "kind": { "enum": ["source_package", "run_event"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "anyOf": [{ "const": "*" }, { "$ref": "#/$defs/safePath" }]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "source_package" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "ref": { "$ref": "#/$defs/fingerprint" } }
          },
          "else": {
            "properties": {
              "ref": { "pattern": "^event_[a-z0-9]{16,64}$" }
            }
          }
        }
      ]
    },
    "testFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "fingerprint"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 7,
          "maxLength": 506,
          "pattern": "^tests/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
