{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "synthetic",
    "activationId",
    "templateId",
    "userId",
    "revision",
    "revisionFingerprint",
    "validFrom",
    "validUntil",
    "owner",
    "pollMillis",
    "leaseSeconds",
    "batchSize",
    "retentionHours",
    "maintenanceEvery"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-cron-worker-plan/v1"
    },
    "synthetic": {
      "const": true
    },
    "activationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}_[a-z0-9]{16,64}$"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}_[a-z0-9]{16,64}$"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "revisionFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pollMillis": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "leaseSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300
    },
    "batchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "retentionHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8760
    },
    "maintenanceEvery": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/contracts/neo-agent-cron-worker-plan.schema.json",
  "title": "Neo Agent Cron Worker Plan"
}
