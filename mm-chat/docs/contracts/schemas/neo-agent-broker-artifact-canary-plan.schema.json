{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-agent-broker-artifact-canary-plan.schema.json",
  "title": "Neo Agent Broker Artifact Canary Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "synthetic",
    "userId",
    "projectId",
    "assistantId",
    "packageFingerprint",
    "runtimeBundleFingerprint",
    "issuedAt",
    "expiresAt",
    "artifactPolicy",
    "sandbox",
    "argv",
    "leaseSeconds",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-broker-artifact-canary-plan/v1"
    },
    "synthetic": {
      "const": true
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "pattern": "^project_[a-z0-9]{8,64}$"
    },
    "assistantId": {
      "type": "string",
      "pattern": "^assistant_[a-z0-9]{8,64}$"
    },
    "packageFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "runtimeBundleFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "issuedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/timestamp"
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxBytes",
        "allowedMediaTypes"
      ],
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "allowedMediaTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text/plain",
              "application/json"
            ]
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeBundleFingerprint",
        "packageFingerprint",
        "image",
        "uid",
        "gid",
        "rootfsReadOnly",
        "noNewPrivileges",
        "capabilities",
        "seccompProfileFingerprint",
        "networkMode",
        "workspaceSnapshotId",
        "workspaceFingerprint",
        "resources"
      ],
      "properties": {
        "runtimeBundleFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "packageFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "image": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "gid": {
          "type": "integer",
          "minimum": 1
        },
        "rootfsReadOnly": {
          "const": true
        },
        "noNewPrivileges": {
          "const": true
        },
        "capabilities": {
          "type": "array",
          "maxItems": 0
        },
        "seccompProfileFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "networkMode": {
          "const": "none"
        },
        "workspaceSnapshotId": {
          "type": "string",
          "pattern": "^workspace_snapshot_[a-z0-9]{16,64}$"
        },
        "workspaceFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpuMillis",
            "memoryMiB",
            "pids",
            "wallSeconds",
            "outputBytes",
            "scratchBytes"
          ],
          "properties": {
            "cpuMillis": {
              "type": "integer",
              "minimum": 100,
              "maximum": 8000
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 64,
              "maximum": 16384
            },
            "pids": {
              "type": "integer",
              "minimum": 8,
              "maximum": 1024
            },
            "wallSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            },
            "scratchBytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 8589934592
            }
          }
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^/opt/neo/bin/"
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "leaseSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "actions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/action"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "project_read"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "workspace_read"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "mcp_read"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "artifact_publish"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "possible_send"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "idempotencyKey",
        "toolIdentity",
        "capability",
        "action",
        "resource",
        "classification",
        "idempotent",
        "approval",
        "arguments",
        "ttlSeconds"
      ],
      "properties": {
        "id": {
          "enum": [
            "project_read",
            "workspace_read",
            "mcp_read",
            "artifact_publish",
            "possible_send"
          ]
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^g21\\.2-broker-canary-[A-Za-z0-9._:-]{1,106}$"
        },
        "toolIdentity": {
          "enum": [
            "project.read",
            "workspace.read",
            "mcp.read",
            "artifact.publish",
            "canary.possible_send"
          ]
        },
        "capability": {
          "enum": [
            "project.read",
            "workspace.read",
            "mcp.read",
            "artifact.publish"
          ]
        },
        "action": {
          "enum": [
            "read_file",
            "call",
            "publish"
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "classification": {
          "enum": [
            "read",
            "mutable"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "approval": {
          "const": "automatic"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 32
        },
        "baseRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "relativePath",
            "expectedBytes",
            "expectedFingerprint",
            "maxBytes"
          ],
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "not": {
                "pattern": "^(?:/|\\.\\.?/|.*(?:^|/)\\.\\.(?:/|$))"
              }
            },
            "expectedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8388608
            },
            "expectedFingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "serverId",
            "serverName",
            "toolName",
            "commandArgv",
            "toolPolicy",
            "maxResultBytes"
          ],
          "properties": {
            "serverId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]{0,127}$"
            },
            "serverName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "toolName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "commandArgv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^/opt/mcp/"
                }
              ],
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "toolPolicy": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "additionalProperties": {
                "const": "read"
              }
            },
            "maxResultBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "mediaType",
            "sizeBytes",
            "fingerprint"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "mediaType": {
              "enum": [
                "text/plain",
                "application/json"
              ]
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 33554432
            },
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": {
              "const": "project_read"
            },
            "toolIdentity": {
              "const": "project.read"
            },
            "capability": {
              "const": "project.read"
            },
            "action": {
              "const": "read_file"
            },
            "classification": {
              "const": "read"
            },
            "idempotent": {
              "const": true
            }
          },
          "required": [
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mcp"
                ]
              },
              {
                "required": [
                  "artifact"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "id": {
              "const": "workspace_read"
            },
            "toolIdentity": {
              "const": "workspace.read"
            },
            "capability": {
              "const": "workspace.read"
            },
            "action": {
              "const": "read_file"
            },
            "classification": {
              "const": "read"
            },
            "idempotent": {
              "const": true
            }
          },
          "required": [
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mcp"
                ]
              },
              {
                "required": [
                  "artifact"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "id": {
              "const": "mcp_read"
            },
            "toolIdentity": {
              "const": "mcp.read"
            },
            "capability": {
              "const": "mcp.read"
            },
            "action": {
              "const": "call"
            },
            "classification": {
              "const": "read"
            },
            "idempotent": {
              "const": true
            }
          },
          "required": [
            "mcp"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "artifact"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "id": {
              "const": "artifact_publish"
            },
            "toolIdentity": {
              "const": "artifact.publish"
            },
            "capability": {
              "const": "artifact.publish"
            },
            "action": {
              "const": "publish"
            },
            "classification": {
              "const": "mutable"
            },
            "idempotent": {
              "const": false
            }
          },
          "required": [
            "artifact"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "mcp"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "id": {
              "const": "possible_send"
            },
            "toolIdentity": {
              "const": "canary.possible_send"
            },
            "capability": {
              "const": "mcp.read"
            },
            "action": {
              "const": "call"
            },
            "classification": {
              "const": "read"
            },
            "idempotent": {
              "const": true
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "mcp"
                ]
              },
              {
                "required": [
                  "artifact"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "description": "Strict G21.2 plan for five independent synthetic Runner-to-Broker canary Runs."
}
