{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/contracts/neo-agent-production-closure.schema.json",
  "title": "Neo Agent production closure evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "release",
    "target",
    "window",
    "checks",
    "cleanup",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-production-closure/v1"
    },
    "evidenceClass": {
      "enum": [
        "template",
        "production"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "migrationHead",
        "runnerManifestSha256",
        "runnerBinarySha256",
        "runtimeBundleFingerprint",
        "operationsPolicySha256"
      ],
      "properties": {
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migrationHead": {
          "const": 93
        },
        "runnerManifestSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "runnerBinarySha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "runtimeBundleFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "operationsPolicySha256": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentFingerprint",
        "hostClass",
        "runnerId",
        "runnerUid",
        "runnerGid"
      ],
      "properties": {
        "deploymentFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "hostClass": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "runnerId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "runnerUid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "runnerGid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "completedAt",
        "expiresAt"
      ],
      "properties": {
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "observedAt",
          "evidenceSha256",
          "detailCode"
        ],
        "properties": {
          "id": {
            "enum": [
              "exact_host_isolation",
              "clean_copy_install",
              "restart_reconcile",
              "host_reboot_reconcile",
              "paired_backup_restore",
              "disaster_recovery",
              "rollback_forward_fix",
              "hierarchical_kill_switch",
              "credential_mtls_rotation",
              "runtime_bundle_rotation",
              "orphan_reconciliation",
              "outcome_unknown_workflow",
              "metrics_alerts",
              "capacity_budgets",
              "bounded_canary",
              "temporary_evidence_cleanup"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "isolation_unavailable"
            ]
          },
          "observedAt": {
            "$ref": "#/$defs/timestamp"
          },
          "evidenceSha256": {
            "$ref": "#/$defs/fingerprint"
          },
          "detailCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporaryCanaryRuns",
        "temporaryDrafts",
        "temporaryArtifacts",
        "temporaryRunEvidence",
        "orphanSandboxes",
        "scratchResidue",
        "promotionRecordRetained"
      ],
      "properties": {
        "temporaryCanaryRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "temporaryDrafts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "temporaryArtifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "temporaryRunEvidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "orphanSandboxes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scratchResidue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "promotionRecordRetained": {
          "const": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewedAt",
        "reviewerFingerprint"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "held"
          ]
        },
        "reviewedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "reviewerFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
