{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-agent-root-run-canary-activation.schema.json",
  "title": "Neo Agent Root Run Canary Activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "stage",
    "release",
    "target",
    "wiring",
    "window",
    "checks",
    "authorization",
    "cleanup",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-production-activation/v1"
    },
    "evidenceClass": {
      "enum": [
        "template",
        "production"
      ]
    },
    "stage": {
      "const": "root_run_canary"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "migrationHead",
        "runnerManifestSha256",
        "runnerBinarySha256",
        "operationsPolicySha256"
      ],
      "properties": {
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migrationHead": {
          "const": 91
        },
        "runnerManifestSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "runnerBinarySha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "operationsPolicySha256": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentFingerprint",
        "runnerId"
      ],
      "properties": {
        "deploymentFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "runnerId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "wiring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointSha256",
        "clientCertificateSha256",
        "serverCASha256",
        "serverName",
        "callerIdentity",
        "canaryPlanSha256",
        "authorityPublicKeySha256"
      ],
      "properties": {
        "endpointSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "clientCertificateSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "serverCASha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "serverName": {
          "$ref": "#/$defs/identity"
        },
        "callerIdentity": {
          "$ref": "#/$defs/identity"
        },
        "canaryPlanSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "authorityPublicKeySha256": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "completedAt",
        "expiresAt"
      ],
      "properties": {
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "observedAt",
          "evidenceSha256",
          "detailCode"
        ],
        "properties": {
          "id": {
            "enum": [
              "control_plane_ready",
              "exact_host_isolation",
              "private_mtls_canary",
              "restart_recovery_ready",
              "rollback_kill_switch_ready",
              "signed_authority_ready",
              "synthetic_plan_ready",
              "zero_inventory"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "isolation_unavailable"
            ]
          },
          "observedAt": {
            "$ref": "#/$defs/timestamp"
          },
          "evidenceSha256": {
            "$ref": "#/$defs/fingerprint"
          },
          "detailCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlane",
        "rootRuns",
        "brokerReadOnly",
        "brokerMutable",
        "delegation",
        "scheduler",
        "learning"
      ],
      "properties": {
        "controlPlane": {
          "const": false
        },
        "rootRuns": {
          "const": true
        },
        "brokerReadOnly": {
          "const": false
        },
        "brokerMutable": {
          "const": false
        },
        "delegation": {
          "const": false
        },
        "scheduler": {
          "const": false
        },
        "learning": {
          "const": false
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orphanSandboxes",
        "scratchResidue"
      ],
      "properties": {
        "orphanSandboxes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scratchResidue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewedAt",
        "reviewerFingerprint"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "held"
          ]
        },
        "reviewedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "reviewerFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "description": "Short-lived G21.1 activation evidence for one synthetic Root Run canary."
}
