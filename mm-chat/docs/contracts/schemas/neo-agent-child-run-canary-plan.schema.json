{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-agent-child-run-canary-plan.schema.json",
  "title": "Neo Agent Depth-One Child Canary Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "synthetic",
    "userId",
    "projectId",
    "assistantId",
    "model",
    "packageFingerprint",
    "runtimeBundleFingerprint",
    "parentIdempotencyKey",
    "childIdempotencyKey",
    "parentStepKind",
    "childStepKind",
    "parentGrantId",
    "delegationResource",
    "grantWindowSeconds",
    "childExpirySeconds",
    "parentBudget",
    "childBudget",
    "toolCatalog",
    "parentRequestedTools",
    "childRequestedTools",
    "parentSandbox",
    "childSandbox",
    "parentArgv",
    "childArgv",
    "parentLeaseSeconds",
    "childLeaseSeconds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-child-run-canary-plan/v1"
    },
    "synthetic": {
      "const": true
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "pattern": "^(?:project|assistant|grant)_[a-z0-9]{8,64}$"
    },
    "assistantId": {
      "type": "string",
      "pattern": "^(?:project|assistant|grant)_[a-z0-9]{8,64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "modelId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "packageFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtimeBundleFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parentIdempotencyKey": {
      "type": "string",
      "pattern": "^g21\\.4-child-canary-parent-[A-Za-z0-9._:-]{1,96}$"
    },
    "childIdempotencyKey": {
      "type": "string",
      "pattern": "^g21\\.4-child-canary-child-[A-Za-z0-9._:-]{1,96}$"
    },
    "parentStepKind": {
      "const": "child_canary_parent"
    },
    "childStepKind": {
      "const": "child_canary_work"
    },
    "parentGrantId": {
      "type": "string",
      "pattern": "^grant_[a-z0-9]{16,64}$"
    },
    "delegationResource": {
      "const": "g21.4/synthetic-child"
    },
    "grantWindowSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 600
    },
    "childExpirySeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 599
    },
    "parentBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxWallSeconds",
        "maxModelTokens",
        "maxToolCalls",
        "maxArtifactBytes"
      ],
      "properties": {
        "maxWallSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxModelTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        }
      }
    },
    "childBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxWallSeconds",
        "maxModelTokens",
        "maxToolCalls",
        "maxArtifactBytes"
      ],
      "properties": {
        "maxWallSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxModelTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        }
      }
    },
    "toolCatalog": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "capability",
            "actions",
            "classification",
            "idempotent"
          ],
          "properties": {
            "identity": {
              "const": "delegate_task"
            },
            "capability": {
              "const": "delegate_task"
            },
            "actions": {
              "const": [
                "create"
              ]
            },
            "classification": {
              "const": "mutable"
            },
            "idempotent": {
              "const": false
            }
          }
        }
      ],
      "items": false
    },
    "parentRequestedTools": {
      "const": [
        "delegate_task"
      ]
    },
    "childRequestedTools": {
      "const": [
        "delegate_task"
      ]
    },
    "parentSandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeBundleFingerprint",
        "packageFingerprint",
        "image",
        "uid",
        "gid",
        "rootfsReadOnly",
        "noNewPrivileges",
        "capabilities",
        "seccompProfileFingerprint",
        "networkMode",
        "workspaceSnapshotId",
        "workspaceFingerprint",
        "resources"
      ],
      "properties": {
        "runtimeBundleFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packageFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "uid": {
          "type": "integer",
          "minimum": 10000
        },
        "gid": {
          "type": "integer",
          "minimum": 10000
        },
        "rootfsReadOnly": {
          "const": true
        },
        "noNewPrivileges": {
          "const": true
        },
        "capabilities": {
          "type": "array",
          "maxItems": 0
        },
        "seccompProfileFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "networkMode": {
          "const": "none"
        },
        "workspaceSnapshotId": {
          "type": "string",
          "pattern": "^workspace_snapshot_[a-z0-9]{16,64}$"
        },
        "workspaceFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpuMillis",
            "memoryMiB",
            "pids",
            "wallSeconds",
            "outputBytes",
            "scratchBytes"
          ],
          "properties": {
            "cpuMillis": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 64,
              "maximum": 512
            },
            "pids": {
              "type": "integer",
              "minimum": 8,
              "maximum": 32
            },
            "wallSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65536
            },
            "scratchBytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 16777216
            }
          }
        }
      }
    },
    "childSandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeBundleFingerprint",
        "packageFingerprint",
        "image",
        "uid",
        "gid",
        "rootfsReadOnly",
        "noNewPrivileges",
        "capabilities",
        "seccompProfileFingerprint",
        "networkMode",
        "workspaceSnapshotId",
        "workspaceFingerprint",
        "resources"
      ],
      "properties": {
        "runtimeBundleFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packageFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "uid": {
          "type": "integer",
          "minimum": 10000
        },
        "gid": {
          "type": "integer",
          "minimum": 10000
        },
        "rootfsReadOnly": {
          "const": true
        },
        "noNewPrivileges": {
          "const": true
        },
        "capabilities": {
          "type": "array",
          "maxItems": 0
        },
        "seccompProfileFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "networkMode": {
          "const": "none"
        },
        "workspaceSnapshotId": {
          "type": "string",
          "pattern": "^workspace_snapshot_[a-z0-9]{16,64}$"
        },
        "workspaceFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpuMillis",
            "memoryMiB",
            "pids",
            "wallSeconds",
            "outputBytes",
            "scratchBytes"
          ],
          "properties": {
            "cpuMillis": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 64,
              "maximum": 512
            },
            "pids": {
              "type": "integer",
              "minimum": 8,
              "maximum": 32
            },
            "wallSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65536
            },
            "scratchBytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 16777216
            }
          }
        }
      }
    },
    "parentArgv": {
      "const": [
        "/opt/neo/bin/child-canary-parent",
        "--wait-for-cancel"
      ]
    },
    "childArgv": {
      "const": [
        "/opt/neo/bin/child-canary-child",
        "--wait-for-cancel"
      ]
    },
    "parentLeaseSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 300
    },
    "childLeaseSeconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 299
    }
  }
}
