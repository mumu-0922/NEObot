{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/contracts/neo-agent-cron-worker-activation.schema.json",
  "title": "Neo Agent Cron Worker Activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "stage",
    "release",
    "prerequisites",
    "target",
    "window",
    "checks",
    "authorization",
    "cleanup",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-production-activation/v1"
    },
    "evidenceClass": {
      "enum": [
        "template",
        "production"
      ]
    },
    "stage": {
      "const": "cron_worker"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "migrationHead",
        "runnerManifestSha256",
        "runnerBinarySha256",
        "operationsPolicySha256"
      ],
      "properties": {
        "gitCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "migrationHead": {
          "const": 94
        },
        "runnerManifestSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runnerBinarySha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "operationsPolicySha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "evidenceSha256"
        ],
        "properties": {
          "stage": {
            "enum": [
              "control_plane",
              "root_run_canary",
              "broker_artifact_canary",
              "project_mutation_canary",
              "child_run_canary"
            ]
          },
          "evidenceSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationId",
        "templateId",
        "templateRevision",
        "templateFingerprint",
        "planSha256"
      ],
      "properties": {
        "activationId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]{0,127}$"
        },
        "templateId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]{0,127}$"
        },
        "templateRevision": {
          "type": "integer",
          "minimum": 1
        },
        "templateFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "completedAt",
        "expiresAt"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "observedAt",
          "evidenceSha256",
          "detailCode"
        ],
        "properties": {
          "id": {
            "enum": [
              "broker_artifact_canary_ready",
              "child_run_canary_ready",
              "control_plane_ready",
              "crash_restart_ready",
              "credential_absence",
              "exact_host_isolation",
              "exact_target_plan",
              "least_privilege_login",
              "project_mutation_canary_ready",
              "root_run_canary_ready"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "isolation_unavailable"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "evidenceSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "detailCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactCronTarget",
        "runtime",
        "genericScheduler",
        "learning",
        "skillInstall",
        "brokerMutation",
        "delegation",
        "runnerCredential",
        "objectCredential"
      ],
      "properties": {
        "exactCronTarget": {
          "const": true
        },
        "runtime": {
          "const": false
        },
        "genericScheduler": {
          "const": false
        },
        "learning": {
          "const": false
        },
        "skillInstall": {
          "const": false
        },
        "brokerMutation": {
          "const": false
        },
        "delegation": {
          "const": false
        },
        "runnerCredential": {
          "const": false
        },
        "objectCredential": {
          "const": false
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staleClaims",
        "pendingTriggers"
      ],
      "properties": {
        "staleClaims": {
          "type": "integer",
          "minimum": 0
        },
        "pendingTriggers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewedAt",
        "reviewerFingerprint"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "held"
          ]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewerFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
