{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-skill-runtime-manifest.schema.json",
  "title": "Neo Skill Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "runtime",
    "entrypoints",
    "capabilityRequests",
    "egressRequests",
    "secretSlots",
    "resources",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": "neo.skill-runtime/v1" },
    "package": { "$ref": "#/$defs/package" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entrypoint" }
    },
    "capabilityRequests": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityRequest" }
    },
    "egressRequests": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/egressRequest" }
    },
    "secretSlots": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/secretSlot" }
    },
    "resources": { "$ref": "#/$defs/resources" },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "dnsName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?![0-9]+(?:\\.[0-9]+){3}$)(?!localhost$)(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sourceType",
        "sourceRef",
        "packageFingerprint",
        "runtimeBundleFingerprint",
        "sbomFingerprint",
        "admissionId"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "sourceType": {
          "enum": ["official", "lobehub", "git", "zip"]
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "packageFingerprint": { "$ref": "#/$defs/fingerprint" },
        "runtimeBundleFingerprint": { "$ref": "#/$defs/fingerprint" },
        "sbomFingerprint": { "$ref": "#/$defs/fingerprint" },
        "admissionId": {
          "type": "string",
          "pattern": "^admission_[a-z0-9]{16,64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sourceType": { "const": "git" } },
            "required": ["sourceType"]
          },
          "then": {
            "properties": {
              "sourceRef": { "pattern": "#[a-f0-9]{40}$" }
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "image", "platform", "user"],
      "properties": {
        "kind": { "const": "rootless_oci" },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
        },
        "platform": {
          "enum": ["linux/amd64", "linux/arm64"]
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uid", "gid"],
          "properties": {
            "uid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "gid": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argv", "workingDirectory"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": { "pattern": "[\\r\\n\\u0000]" }
          }
        },
        "workingDirectory": {
          "enum": ["/workspace", "/scratch"]
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "actions", "reason"],
      "properties": {
        "capability": { "$ref": "#/$defs/identifier" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    },
    "egressRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "schemes", "hosts", "ports", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "mode": { "enum": ["allowlist", "brokered"] },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["https", "wss"] }
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dnsName" }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    },
    "secretSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "delivery", "required"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "delivery": { "const": "broker_handle" },
        "required": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMillis", "memoryMiB", "pids", "wallSeconds"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 100, "maximum": 8000 },
        "memoryMiB": { "type": "integer", "minimum": 64, "maximum": 16384 },
        "pids": { "type": "integer", "minimum": 8, "maximum": 1024 },
        "wallSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPackageFiles",
        "maxPackageBytes",
        "maxExpandedBytes",
        "maxStdoutBytes",
        "maxStderrBytes",
        "maxArtifactBytes"
      ],
      "properties": {
        "maxPackageFiles": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxPackageBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "maxExpandedBytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "maxStdoutBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "maxStderrBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      }
    }
  }
}
