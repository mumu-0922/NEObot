{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-capability-grant.schema.json",
  "title": "Neo Capability Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grantId",
    "subject",
    "run",
    "packageFingerprint",
    "runtimeBundleFingerprint",
    "issuedAt",
    "expiresAt",
    "capabilities",
    "egress",
    "secrets",
    "budget"
  ],
  "properties": {
    "schemaVersion": { "const": "neo.capability-grant/v1" },
    "grantId": { "type": "string", "pattern": "^grant_[a-z0-9]{16,64}$" },
    "subject": { "$ref": "#/$defs/subject" },
    "run": { "$ref": "#/$defs/run" },
    "packageFingerprint": { "$ref": "#/$defs/fingerprint" },
    "runtimeBundleFingerprint": { "$ref": "#/$defs/fingerprint" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "egress": { "$ref": "#/$defs/egress" },
    "secrets": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/secret" }
    },
    "budget": { "$ref": "#/$defs/budget" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run": {
            "properties": { "depth": { "const": 1 } },
            "required": ["depth"]
          }
        },
        "required": ["run"]
      },
      "then": {
        "properties": {
          "capabilities": {
            "not": {
              "contains": {
                "properties": {
                  "capability": {
                    "enum": [
                      "delegate_task",
                      "cron_manage",
                      "grant_manage",
                      "secret_manage",
                      "runtime_manage"
                    ]
                  }
                },
                "required": ["capability"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "projectId", "assistantId"],
      "properties": {
        "userId": { "type": "string", "pattern": "^user_[a-z0-9]{8,64}$" },
        "projectId": { "type": "string", "pattern": "^project_[a-z0-9]{8,64}$" },
        "assistantId": { "type": "string", "pattern": "^assistant_[a-z0-9]{8,64}$" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "depth"],
      "properties": {
        "runId": { "type": "string", "pattern": "^run_[a-z0-9]{16,64}$" },
        "parentRunId": { "type": "string", "pattern": "^run_[a-z0-9]{16,64}$" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "depth": { "const": 0 } }, "required": ["depth"] },
          "then": { "not": { "required": ["parentRunId"] } }
        },
        {
          "if": { "properties": { "depth": { "const": 1 } }, "required": ["depth"] },
          "then": { "required": ["parentRunId"] }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": { "enum": ["exact", "prefix"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "actions", "resources", "approval", "maxCalls"],
      "properties": {
        "capability": { "$ref": "#/$defs/identifier" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "resources": { "$ref": "#/$defs/selector" },
        "approval": { "enum": ["automatic", "once", "per_commit", "denied"] },
        "maxCalls": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rules"],
      "properties": {
        "mode": { "enum": ["none", "allowlist", "brokered"] },
        "rules": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "host", "ports"],
            "properties": {
              "scheme": { "enum": ["https", "wss"] },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^(?![0-9]+(?:\\.[0-9]+){3}$)(?!localhost$)(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
          "then": { "properties": { "rules": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "mode": { "enum": ["allowlist", "brokered"] } }, "required": ["mode"] },
          "then": { "properties": { "rules": { "minItems": 1 } } }
        }
      ]
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "brokerRef", "actions", "ttlSeconds"],
      "properties": {
        "slot": { "$ref": "#/$defs/identifier" },
        "brokerRef": { "type": "string", "pattern": "^secret_ref_[a-z0-9]{16,64}$" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "ttlSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWallSeconds", "maxModelTokens", "maxToolCalls", "maxArtifactBytes"],
      "properties": {
        "maxWallSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "maxModelTokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxToolCalls": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxArtifactBytes": { "type": "integer", "minimum": 0, "maximum": 10737418240 }
      }
    }
  }
}
