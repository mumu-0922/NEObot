{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/schemas/neo-agent-product-canary-plan.schema.json",
  "title": "Neo Agent Product Canary Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activationId",
    "stepKind",
    "grantId",
    "grantFingerprint",
    "snapshot",
    "sandbox",
    "toolRegistry",
    "argv",
    "leaseSeconds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-product-canary-plan/v1"
    },
    "activationId": {
      "type": "string",
      "pattern": "^activation_[a-z0-9]{16,64}$"
    },
    "stepKind": {
      "const": "product_canary"
    },
    "grantId": {
      "type": "string",
      "pattern": "^grant_[a-z0-9]{16,64}$"
    },
    "grantFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "packageFingerprint",
        "runtimeBundleFingerprint",
        "grantFingerprint",
        "registryFingerprint",
        "workspaceFingerprint",
        "noEgress",
        "noSecrets",
        "maxWallSeconds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "neo.agent-snapshot/v1"
        },
        "mode": {
          "const": "read_only"
        },
        "packageFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtimeBundleFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "grantFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "registryFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workspaceFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "noEgress": {
          "const": true
        },
        "noSecrets": {
          "const": true
        },
        "maxWallSeconds": {
          "const": 30
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeBundleFingerprint",
        "packageFingerprint",
        "image",
        "uid",
        "gid",
        "rootfsReadOnly",
        "noNewPrivileges",
        "capabilities",
        "seccompProfileFingerprint",
        "networkMode",
        "workspaceSnapshotId",
        "workspaceFingerprint",
        "resources"
      ],
      "properties": {
        "runtimeBundleFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packageFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "uid": {
          "const": 10001
        },
        "gid": {
          "const": 10001
        },
        "rootfsReadOnly": {
          "const": true
        },
        "noNewPrivileges": {
          "const": true
        },
        "capabilities": {
          "type": "array",
          "maxItems": 0
        },
        "seccompProfileFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "networkMode": {
          "const": "none"
        },
        "workspaceSnapshotId": {
          "type": "string",
          "pattern": "^workspace_snapshot_[a-z0-9]{16,64}$"
        },
        "workspaceFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpuMillis",
            "memoryMiB",
            "pids",
            "wallSeconds",
            "outputBytes",
            "scratchBytes"
          ],
          "properties": {
            "cpuMillis": {
              "const": 250
            },
            "memoryMiB": {
              "const": 128
            },
            "pids": {
              "const": 16
            },
            "wallSeconds": {
              "const": 30
            },
            "outputBytes": {
              "const": 4096
            },
            "scratchBytes": {
              "const": 1048576
            }
          }
        }
      }
    },
    "toolRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth",
        "tools",
        "registryFingerprint"
      ],
      "properties": {
        "depth": {
          "const": 0
        },
        "tools": {
          "type": "array",
          "maxItems": 0
        },
        "registryFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": "/opt/neo/bin/product-canary"
        },
        {
          "const": "--bounded-smoke"
        }
      ],
      "items": false
    },
    "leaseSeconds": {
      "const": 30
    }
  }
}
