{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-chat.local/contracts/neo-agent-production-activation.schema.json",
  "title": "Neo Agent staged production activation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "stage",
    "release",
    "target",
    "wiring",
    "window",
    "checks",
    "authorization",
    "cleanup",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "neo.agent-production-activation/v1"
    },
    "evidenceClass": {
      "enum": [
        "template",
        "production"
      ]
    },
    "stage": {
      "const": "control_plane"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "migrationHead",
        "runnerManifestSha256",
        "runnerBinarySha256",
        "operationsPolicySha256"
      ],
      "properties": {
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migrationHead": {
          "const": 95
        },
        "runnerManifestSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "runnerBinarySha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "operationsPolicySha256": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentFingerprint",
        "runnerId"
      ],
      "properties": {
        "deploymentFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "runnerId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "wiring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointSha256",
        "clientCertificateSha256",
        "serverCASha256",
        "serverName",
        "callerIdentity"
      ],
      "properties": {
        "endpointSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "clientCertificateSha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "serverCASha256": {
          "$ref": "#/$defs/fingerprint"
        },
        "serverName": {
          "$ref": "#/$defs/identity"
        },
        "callerIdentity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "completedAt",
        "expiresAt"
      ],
      "properties": {
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "observedAt",
          "evidenceSha256",
          "detailCode"
        ],
        "properties": {
          "id": {
            "enum": [
              "exact_host_isolation",
              "clean_copy_install",
              "private_mtls_probe",
              "zero_inventory_reconcile",
              "rollback_kill_switch_ready"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "isolation_unavailable"
            ]
          },
          "observedAt": {
            "$ref": "#/$defs/timestamp"
          },
          "evidenceSha256": {
            "$ref": "#/$defs/fingerprint"
          },
          "detailCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlane",
        "rootRuns",
        "brokerReadOnly",
        "brokerMutable",
        "delegation",
        "scheduler",
        "learning"
      ],
      "properties": {
        "controlPlane": {
          "const": true
        },
        "rootRuns": {
          "const": false
        },
        "brokerReadOnly": {
          "const": false
        },
        "brokerMutable": {
          "const": false
        },
        "delegation": {
          "const": false
        },
        "scheduler": {
          "const": false
        },
        "learning": {
          "const": false
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orphanSandboxes",
        "scratchResidue"
      ],
      "properties": {
        "orphanSandboxes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scratchResidue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewedAt",
        "reviewerFingerprint"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "held"
          ]
        },
        "reviewedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "reviewerFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
