{
  "version": 1,
  "servers": [
    {
      "id": "playwright-browser-0.0.79",
      "name": "Browser (Playwright)",
      "description": "Run-scoped headless browser automation for opening pages, reading the DOM, clicking, filling forms, and verifying the resulting page state.",
      "icon": "https://github.com/microsoft.png",
      "transport": "stdio",
      "instanceScope": "run",
      "command": {
        "argv": [
          "/opt/mcp-runner/node_modules/.bin/playwright-mcp",
          "--headless",
          "--isolated",
          "--browser",
          "chromium",
          "--no-sandbox",
          "--block-service-workers",
          "--image-responses",
          "omit",
          "--codegen",
          "none",
          "--timeout-action",
          "5000",
          "--timeout-navigation",
          "20000"
        ],
        "idleTimeout": "5m",
        "maxLifetime": "1h"
      },
      "allowedTools": [
        "browser_click",
        "browser_close",
        "browser_console_messages",
        "browser_drag",
        "browser_fill_form",
        "browser_find",
        "browser_handle_dialog",
        "browser_hover",
        "browser_navigate",
        "browser_navigate_back",
        "browser_press_key",
        "browser_resize",
        "browser_select_option",
        "browser_snapshot",
        "browser_tabs",
        "browser_type",
        "browser_wait_for"
      ],
      "toolPolicy": {
        "browser_click": "write",
        "browser_close": "write",
        "browser_console_messages": "read",
        "browser_drag": "write",
        "browser_fill_form": "write",
        "browser_find": "read",
        "browser_handle_dialog": "write",
        "browser_hover": "write",
        "browser_navigate": "write",
        "browser_navigate_back": "write",
        "browser_press_key": "write",
        "browser_resize": "write",
        "browser_select_option": "write",
        "browser_snapshot": "read",
        "browser_tabs": "write",
        "browser_type": "write",
        "browser_wait_for": "write"
      }
    },
    {
      "id": "marketplace-upstash-context7-2.2.0",
      "name": "Context7",
      "description": "Audited Context7 MCP artifact for LobeHub Marketplace installs.",
      "icon": "https://github.com/upstash.png",
      "transport": "stdio",
      "command": {
        "argv": [
          "/opt/mcp-runner/node_modules/.bin/context7-mcp"
        ],
        "env": [
          {
            "name": "CONTEXT7_TELEMETRY_DISABLED",
            "value": "1"
          }
        ],
        "idleTimeout": "15m",
        "maxLifetime": "24h"
      },
      "marketplace": {
        "provider": "lobehub",
        "identifier": "upstash-context7",
        "version": "2.2.0",
        "connectionType": "stdio",
        "installationMethod": "npm",
        "command": "npx",
        "args": [
          "ctx7"
        ],
        "packageName": "@upstash/context7-mcp"
      },
      "toolPolicy": {
        "resolve-library-id": "read",
        "query-docs": "read"
      }
    },
    {
      "id": "marketplace-tavily-ai-tavily-mcp-0.2.19",
      "name": "Tavily MCP",
      "description": "Audited Tavily MCP artifact for per-user API-key Marketplace installs.",
      "icon": "https://github.com/tavily-ai.png",
      "transport": "stdio",
      "command": {
        "argv": [
          "/opt/mcp-runner/node_modules/.bin/tavily-mcp"
        ],
        "userSecretEnv": [
          "TAVILY_API_KEY"
        ],
        "idleTimeout": "15m",
        "maxLifetime": "24h"
      },
      "credentialProbe": {
        "endpointUrl": "https://api.tavily.com/usage",
        "method": "GET",
        "secretField": "TAVILY_API_KEY",
        "headerName": "Authorization",
        "headerPrefix": "Bearer "
      },
      "marketplace": {
        "provider": "lobehub",
        "identifier": "tavily-ai-tavily-mcp",
        "version": "0.2.19",
        "connectionType": "stdio",
        "installationMethod": "npm",
        "command": "npx",
        "args": [
          "-y",
          "tavily-mcp@latest"
        ],
        "packageName": "tavily-mcp"
      },
      "toolPolicy": {
        "tavily_search": "read",
        "tavily_extract": "read",
        "tavily_map": "read",
        "tavily_crawl": "read",
        "tavily_research": "read"
      }
    }
  ]
}
